---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MoonPath from '../components/MoonPath.astro';
// Self-hosted fonts (only the faces the system uses): Frank Ruhl Libre 500, Assistant 400/600
import '@fontsource/frank-ruhl-libre/hebrew-500.css';
import '@fontsource/frank-ruhl-libre/latin-500.css';
import '@fontsource/assistant/hebrew-400.css';
import '@fontsource/assistant/latin-400.css';
import '@fontsource/assistant/hebrew-600.css';
import '@fontsource/assistant/latin-600.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Hide the mobile floating "book" button (e.g. on /book itself) */
  hideFab?: boolean;
  noindex?: boolean;
  /** Home page: enables the first-visit preloader */
  preloader?: boolean;
  /** Transparent header over a full-bleed hero until the user scrolls */
  overlayHeader?: boolean;
}

const { title, description, hideFab = false, noindex = false, overlayHeader = false, preloader = false } = Astro.props;
const fullTitle = title.startsWith('שחקים') ? title : `${title} · שחקים`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="he" dir="rtl" class:list={[{ 'overlay-header at-top': overlayHeader }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0B0E1A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="שחקים" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg?v=2', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="שחקים: סוויטות לתצפית כוכבים על שפת מכתש רמון" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      preloader && (
        <script is:inline>
          // Decide before first paint, so returning visitors never see the preloader flash
          try {
            if (!sessionStorage.getItem('shchakim-seen') && !matchMedia('(prefers-reduced-motion: reduce)').matches)
              document.documentElement.classList.add('pl-on');
          } catch (e) {}
        </script>
      )
    }
    <slot name="head" />
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a href="#main" class="skip-link">דילוג לתוכן</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!hideFab && <MoonPath />}

    {
      !hideFab && (
        <a href="/book" class="fab btn" data-fab>
          להזמין לילה
        </a>
      )
    }
    <script>
      import { initReveal } from '../scripts/reveal';
      import { initCursor } from '../scripts/cursor';
      document.addEventListener('astro:page-load', initReveal);
      document.addEventListener('astro:page-load', initCursor);
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
  .fab {
    display: none;
  }
  @media (max-width: 767px) {
    .fab {
      display: inline-flex;
      position: fixed;
      z-index: 40;
      inset-inline: 1rem;
      inset-block-end: max(1rem, env(safe-area-inset-bottom));
      box-shadow: 0 10px 30px rgb(0 0 0 / 0.45);
      transform: translateY(calc(100% + 2rem));
      transition: transform 0.4s var(--ease-out);
    }
    .fab.is-visible {
      transform: none;
    }
  }
</style>
