---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MoonPath from '../components/MoonPath.astro';
// Self-hosted fonts (only the faces the system uses): Frank Ruhl Libre 500, Assistant 400/600
import '@fontsource/frank-ruhl-libre/hebrew-500.css';
import '@fontsource/frank-ruhl-libre/latin-500.css';
import '@fontsource/assistant/hebrew-400.css';
import '@fontsource/assistant/latin-400.css';
import '@fontsource/assistant/hebrew-600.css';
import '@fontsource/assistant/latin-600.css';
import '../styles/global.css';
import { suites } from '../data/pricing';
import { formatPrice } from '../lib/format';

interface Props {
  title: string;
  description: string;
  /** Hide the mobile floating "book" button (e.g. on /book itself) */
  hideFab?: boolean;
  noindex?: boolean;
  /** Transparent header over a full-bleed hero until the user scrolls */
  overlayHeader?: boolean;
}

const { title, description, hideFab = false, noindex = false, overlayHeader = false } = Astro.props;
const fullTitle = title.startsWith('שחקים') ? title : `${title} · שחקים`;
const minNightly = Math.min(...suites.map((s) => s.nightly));
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="he" dir="rtl" class:list={[{ 'overlay-header at-top': overlayHeader }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0B0E1A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content="שחקים" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg?v=3', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="שחקים: סוויטות לתצפית כוכבים על שפת מכתש רמון" />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <a href="#main" class="skip-link">דילוג לתוכן</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!hideFab && <MoonPath />}

    {
      !hideFab && (
        <div class="fab" data-fab>
          <p class="fab__price">
            החל מ־<bdi>{formatPrice(minNightly)}</bdi> ללילה
          </p>
          <a href="/book" class="btn fab__btn">להזמין לילה</a>
        </div>
      )
    }
    <script>
      import { initReveal } from '../scripts/reveal';
      import { initCursor } from '../scripts/cursor';
      document.addEventListener('astro:page-load', initReveal);
      document.addEventListener('astro:page-load', initCursor);
    </script>
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
  .fab {
    display: none;
  }
  @media (max-width: 767px) {
    /* a glass pill: the price on the start side, the booking button on the end side */
    .fab {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      position: fixed;
      z-index: 45;
      inset-inline: 1rem;
      inset-block-end: max(1rem, env(safe-area-inset-bottom));
      padding: 0.4rem;
      padding-inline-start: 1.1rem;
      border-radius: 999px;
      border: 1px solid rgb(217 168 108 / 0.35);
      background: rgb(11 14 26 / 0.82);
      -webkit-backdrop-filter: blur(16px);
      backdrop-filter: blur(16px);
      box-shadow: 0 12px 32px rgb(0 0 0 / 0.45);
      opacity: 0;
      visibility: hidden;
      transform: translateY(calc(100% + 1.5rem));
      transition:
        transform 0.45s var(--ease-out),
        opacity 0.35s var(--ease-out),
        visibility 0s linear 0.45s;
    }
    .fab.is-visible {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition:
        transform 0.45s var(--ease-out),
        opacity 0.35s var(--ease-out);
    }
    .fab__price {
      font-size: var(--fs-small);
      color: var(--muted);
      white-space: nowrap;
    }
    .fab__price bdi {
      color: var(--starlight);
      font-weight: 600;
    }
    .fab__btn {
      border-radius: 999px;
      white-space: nowrap;
    }
  }
</style>
