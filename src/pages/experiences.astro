---
import Base from '../layouts/Base.astro';
import { addons } from '../data/pricing';
import { formatPrice } from '../lib/format';
import Photo from '../components/Photo.astro';
import R3MoonCalendar from '../components/R3MoonCalendar.astro';
import R2SkyMap from '../components/R2SkyMap.astro';
import PageHero from '../components/PageHero.astro';
import { photos } from '../data/images';
---

<Base
  title="חוויות"
  description="תצפית מודרכת עם אסטרונום, סדנת צילום כוכבים, ארוחת ערב במדבר וג׳יפ לזריחה. החוויות שאפשר להוסיף ללילה בשחקים."
  overlayHeader
>
  <PageHero
    photo={photos.galaxiaRoof}
    title="חוויות"
    lead="תצפיות מודרכות, מפת שמיים ולוח ירח. כל מה שצריך כדי לתכנן לילה של כוכבים."
    focus="50% 40%"
  />

  <div class="container">
    <div class="section">
      <R2SkyMap />
    </div>


    <section class="section" aria-labelledby="addons-title">
      <div class="section-head">
        <h2 id="addons-title">אפשר להוסיף להזמנה</h2>
        <p>בוחרים את החוויות בשלב התוספות, בתהליך ההזמנה.</p>
      </div>
      <ul role="list" class="addons">
        {
          addons.map((a, i) => (
            <li class:list={['addon', { 'addon--flip': i % 2 === 1 }]}>
              <figure class="plate addon__art" data-media>
                <Photo photo={a.photo} sizes="(min-width: 900px) 55vw, 100vw" width={1500} height={1000} />
              </figure>
              <div class="addon__body">
                <h3>{a.name}</h3>
                <p>{a.summary}</p>
                <p class="addon__meta">
                  <span>{a.duration}</span>
                  <span aria-hidden="true">·</span>
                  <span>
                    <bdi class="price">{formatPrice(a.price)}</bdi> {a.pricing === 'perPerson' ? 'לאדם' : 'להזמנה'}
                  </span>
                </p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="addons-cta"><a href="/book" class="btn">להזמין לילה עם חוויה</a></p>
    </section>

    <!-- The moon calendar is long (60 nights), so it closes the page -->
    <div class="section">
      <R3MoonCalendar />
    </div>
  </div>
</Base>

<script>
  import { initMedia } from '../scripts/media';
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.addons')) return;
    const stop = initMedia();
    document.addEventListener('astro:before-swap', stop, { once: true });
  });
</script>

<style>
  /* Each experience is an editorial row: a large photograph, then what it is,
     how long, and what it costs. Sides alternate down the page. */
  .addons {
    display: grid;
    gap: clamp(3rem, 8vw, 5.5rem);
    margin-block-start: clamp(1.5rem, 4vw, 2.5rem);
  }
  .addon {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .addon {
      grid-template-columns: 1.4fr 1fr;
    }
    .addon--flip .addon__art {
      order: 2;
    }
  }
  .addon__art {
    aspect-ratio: 3 / 2;
  }
  .addon__body {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .addon h3 {
    font-size: var(--fs-h2);
    line-height: 1.08;
  }
  .addon p {
    color: var(--muted);
    font-size: var(--fs-lead);
    max-width: 34ch;
  }
  .addon .addon__meta {
    color: var(--starlight);
    font-size: var(--fs-body);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid var(--line);
  }
  .addons-cta {
    margin-block-start: clamp(2.5rem, 6vw, 4rem);
  }
</style>
