---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { photos } from '../data/images';
import { site } from '../data/site';
---

<Base title="תודה" description="קיבלנו את בקשת ההזמנה שלכם. נחזור אליכם תוך יום עסקים לאישור." noindex>
  <section class="thanks">
    <figure class="plate thanks__plate"><Photo photo={photos.rimDeck} decorative eager sizes="100vw" /></figure>
    <div class="thanks__shade" aria-hidden="true"></div>
    <div class="container thanks__inner">
      <h1 data-thanks-title>תודה. השמיים שמורים לכם</h1>
      <p class="thanks__stay" data-thanks-stay hidden></p>
      <p>
        קיבלנו את הפרטים. נחזור אליכם תוך יום עסקים כדי לאשר את התאריכים ולענות על כל שאלה. לא חויבתם
        בשום תשלום.
      </p>
      <p>
        אם משהו דחוף, אפשר להתקשר:
        <a href={site.phoneHref}><bdi dir="ltr">{site.phone}</bdi></a>
      </p>
      <div class="thanks__actions">
        <a href="/experiences" class="btn">להכיר את החוויות</a>
        <a href="/" class="btn btn--ghost">חזרה לדף הבית</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks__plate {
    position: absolute;
    inset: 0;
    z-index: -2;
    border-radius: 0;
  }
  .thanks__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(11 14 26 / 0.7), rgb(11 14 26 / 0.55) 40%, var(--night));
  }
  .thanks {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: calc(var(--header-h) + 2rem) 10rem;
  }
  .thanks__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.1rem;
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
  .thanks h1 {
    font-size: var(--step-4);
    font-weight: 500;
  }
  .thanks p {
    color: var(--muted);
  }
  .thanks a:not(.btn) {
    color: var(--sand);
  }
  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }
  .thanks__stay {
    color: var(--sand) !important;
    font-size: var(--step-1);
  }
</style>

<script>
  import { formatDateHe } from '../lib/dates';
  // Personalise with the booking just sent (stored by the wizard; storage may be unavailable)
  document.addEventListener('astro:page-load', () => {
    const stay = document.querySelector<HTMLElement>('[data-thanks-stay]');
    if (!stay) return;
    try {
      const b = JSON.parse(sessionStorage.getItem('shchakim-last-booking') ?? 'null');
      if (!b?.name) return;
      const first = String(b.name).split(' ')[0];
      document.querySelector('[data-thanks-title]')!.textContent = `תודה, ${first}. השמיים שמורים לכם`;
      stay.textContent = `${b.suite}, ${formatDateHe(b.checkIn)} עד ${formatDateHe(b.checkOut)}`;
      stay.hidden = false;
    } catch {
      /* keep the generic message */
    }
  });
</script>
