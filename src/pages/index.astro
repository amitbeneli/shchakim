---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site } from '../data/site';
import { suites, addons } from '../data/pricing';
import { photos } from '../data/images';
import { faq } from '../data/faq';
import { formatNumber, formatPrice } from '../lib/format';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'שחקים',
  alternateName: 'SHCHAKIM',
  description: 'לודג׳ בוטיק לתצפית כוכבים עם 9 סוויטות על שפת מכתש רמון.',
  url: Astro.site?.href,
  telephone: '+972-8-0000000',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'דרך בראשית',
    addressLocality: 'מצפה רמון',
    addressCountry: 'IL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.stats.rating,
    reviewCount: site.stats.reviews,
    bestRating: 5,
  },
  priceRange: '₪1,450-₪2,690',
  checkinTime: '15:00',
  checkoutTime: '11:00',
  numberOfRooms: site.stats.suites,
};

const reasons = [
  { title: 'שמיים כהים באמת', text: 'אין כאן אורות עיר. בלילה בהיר שביל החלב נראה בעין, בלי טלסקופ.' },
  { title: 'חדרים שנבנו לתצפית', text: 'מרפסות פתוחות, תקרות זכוכית וטלסקופים. כל סוויטה מכוונת אל השמיים.' },
  { title: 'מדבר בקצב אחר', text: 'שקט עמוק, אוויר יבש ונוף של מכתש. מגיעים לסוף שבוע ויוצאים עם תחושה של שבוע.' },
];
---

<Base
  title="שחקים"
  description="לודג׳ בוטיק לתצפית כוכבים על שפת מכתש רמון. תשע סוויטות עם מרפסות פתוחות, תקרות זכוכית וטלסקופים, ויותר מ־300 לילות צלולים בשנה."
  overlayHeader
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

  <!-- HERO. Stage 3 layers the R1 sunset-to-night scroll scene over this photo. -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <Photo photo={photos.heroSky} class="hero__img" eager decorative sizes="100vw" />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="container hero__inner">
      <p class="hero__place">מצפה רמון</p>
      <h1 id="hero-title">לילה אחד מתחת<br />לשמיים שלמים</h1>
      <p class="hero__lead">תשע סוויטות על שפת המכתש, בנויות לדבר אחד: להסתכל למעלה.</p>
      <div class="hero__actions">
        <a href="/book" class="btn">להזמין לילה</a>
        <a href="/suites" class="btn btn--ghost">הסוויטות</a>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="intro container" aria-labelledby="intro-title">
    <div class="intro__text">
      <h2 id="intro-title">כשהאור האחרון יורד אל המכתש, מתחיל כאן היום האמיתי</h2>
      <p>
        שחקים הוא לודג׳ קטן על שפת מכתש רמון. תשע סוויטות, מדריכים שמכירים כל כוכב בשמו, ולילות שקטים
        כל כך שאפשר לשמוע את המדבר נושם.
      </p>
      <a href="/story" class="text-link">הסיפור שלנו</a>
    </div>
    <div class="intro__media">
      <Photo photo={photos.archDoor} class="intro__a" sizes="(min-width: 900px) 34vw, 70vw" />
      <Photo photo={photos.lodgeNight} class="intro__b" sizes="(min-width: 900px) 22vw, 50vw" />
    </div>
  </section>

  <!-- STATS -->
  <section class="stats" aria-label="שחקים במספרים">
    <dl class="container stats__list">
      <div><dt>אורחים מאז {site.openedYear}</dt><dd><bdi>{formatNumber(site.stats.guests)}</bdi></dd></div>
      <div><dt>לילות צלולים בשנה</dt><dd><bdi dir="ltr">{site.stats.clearNights}+</bdi></dd></div>
      <div><dt>דירוג מתוך {site.stats.reviews} ביקורות</dt><dd><bdi>{site.stats.rating}</bdi></dd></div>
      <div><dt>סוויטות, שלושה סוגים</dt><dd><bdi>{site.stats.suites}</bdi></dd></div>
    </dl>
  </section>

  <!-- SUITES (R4 horizontal gallery lands in stage 3) -->
  <section class="suites" aria-labelledby="suites-title">
    <div class="container suites__head">
      <h2 id="suites-title">שלוש דרכים להירדם מתחת לכוכבים</h2>
      <a href="/suites" class="text-link">כל הסוויטות</a>
    </div>
    <ul role="list" class="suites__track container">
      {
        suites.map((s) => (
          <li class="suite">
            <a href={`/suites/${s.slug}`} class="suite__link">
              <div class="suite__media" transition:name={`suite-media-${s.slug}`}>
                <Photo photo={s.photo} sizes="(min-width: 900px) 30vw, 80vw" width={900} height={1200} />
              </div>
              <h3>{s.name}</h3>
              <p class="suite__hl">{s.highlight}</p>
              <p class="suite__meta">
                עד {s.maxGuests} אורחים<span aria-hidden="true"> · </span>
                <bdi class="price">{formatPrice(s.nightly)}</bdi> ללילה
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- WHY HERE, over the Milky Way -->
  <section class="why" aria-labelledby="why-title">
    <Photo photo={photos.duneMilkyWay} class="why__img" decorative sizes="100vw" />
    <div class="why__shade" aria-hidden="true"></div>
    <div class="container why__inner">
      <h2 id="why-title">למה דווקא כאן</h2>
      <ul role="list" class="why__list">
        {
          reasons.map((r) => (
            <li>
              <h3>{r.title}</h3>
              <p>{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- EXPERIENCES -->
  <section class="exp container" aria-labelledby="exp-title">
    <div class="exp__head">
      <h2 id="exp-title">מה עושים בלילה</h2>
      <p>חוויות שאפשר להוסיף לכל הזמנה.</p>
    </div>
    <ul role="list" class="exp__grid">
      {
        addons.map((a) => (
          <li class="exp__item">
            <Photo photo={a.photo} sizes="(min-width: 900px) 24vw, 50vw" width={800} height={1000} />
            <h3>{a.name}</h3>
            <p>
              {a.duration}<span aria-hidden="true"> · </span>
              <bdi class="price">{formatPrice(a.price)}</bdi> {a.pricing === 'perPerson' ? 'לאדם' : 'להזמנה'}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- FAQ (R10 animation lands in stage 3) -->
  <section class="faq-wrap container" aria-labelledby="faq-title">
    <h2 id="faq-title">לפני שיוצאים לדרך</h2>
    <div class="faq">
      {
        faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" aria-labelledby="cta-title">
    <Photo photo={photos.canyonCandles} class="cta__img" decorative sizes="100vw" />
    <div class="cta__shade" aria-hidden="true"></div>
    <div class="container cta__inner">
      <h2 id="cta-title">הלילה הבא שלכם כבר על המפה</h2>
      <p>בוחרים תאריך, בוחרים סוויטה, ואנחנו דואגים לשאר.</p>
      <a href="/book" class="btn">להזמין לילה</a>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__img,
  .why__img,
  .cta__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero__img {
    object-position: 50% 35%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgb(11 14 26 / 0.55) 0%, transparent 22%),
      linear-gradient(to top, var(--night) 2%, rgb(11 14 26 / 0.7) 30%, transparent 62%);
  }
  .hero__inner {
    display: grid;
    gap: 1.1rem;
    padding-block: 0 clamp(3rem, 9vh, 6rem);
  }
  .hero__place {
    color: var(--sand);
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 1.4rem + 6vw, 6.2rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .hero__lead {
    font-size: var(--step-1);
    max-width: 30ch;
    color: rgb(244 241 232 / 0.85);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
  }
  @media (max-width: 420px) {
    .hero__actions .btn {
      flex: 1;
    }
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sand);
    font-weight: 700;
    text-decoration: none;
    padding-block: 0.4rem;
    border-block-end: 1px solid rgb(217 168 108 / 0.4);
    justify-self: start;
    transition: border-color 0.2s ease;
  }
  .text-link:hover {
    border-color: var(--sand);
  }

  /* ── Intro ── */
  .intro {
    display: grid;
    gap: 3rem;
    padding-block: clamp(5rem, 12vw, 10rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
  }
  .intro__text {
    display: grid;
    gap: 1.5rem;
  }
  .intro h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
    line-height: 1.15;
  }
  .intro p {
    color: var(--muted);
    font-size: var(--step-1);
    max-width: 38ch;
  }
  .intro__media {
    position: relative;
    padding-block-end: 18%;
  }
  .intro__media :global(img) {
    object-fit: cover;
    border-radius: var(--radius);
  }
  .intro__a {
    width: 78%;
    aspect-ratio: 4 / 5;
    margin-inline-start: auto;
  }
  .intro__b {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    width: 48%;
    aspect-ratio: 1;
    border: 6px solid var(--night);
  }

  /* ── Stats ── */
  .stats {
    border-block: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .stats__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem 1rem;
    margin-block: 0;
  }
  @media (min-width: 768px) {
    .stats__list {
      grid-template-columns: repeat(4, 1fr);
    }
    .stats__list > div + div {
      border-inline-start: 1px solid var(--line);
      padding-inline-start: 2rem;
    }
  }
  .stats__list > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4rem);
    line-height: 1;
    color: var(--starlight);
  }
  .stats dt {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* ── Suites ── */
  .suites {
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .suites__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
  }
  .suites h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
    max-width: 16ch;
  }
  .suites__track {
    display: grid;
    gap: 1.5rem;
  }
  /* Mobile: native swipe carousel, RTL scroll starts at the right edge */
  @media (max-width: 899px) {
    .suites__track {
      grid-auto-flow: column;
      grid-auto-columns: 80%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      padding-block-end: 0.5rem;
      scrollbar-width: none;
      overscroll-behavior-x: contain;
    }
    .suites__track::-webkit-scrollbar {
      display: none;
    }
    .suite {
      scroll-snap-align: start;
    }
  }
  @media (min-width: 900px) {
    .suites__track {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(1.5rem, 3vw, 3rem);
    }
    .suite:nth-child(2) {
      margin-block-start: 4rem;
    }
  }
  .suite__link {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
  }
  .suite__media {
    overflow: hidden;
    border-radius: var(--radius);
    margin-block-end: 0.9rem;
  }
  .suite__media :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .suite__link:hover :global(img) {
      transform: scale(1.04);
    }
  }
  .suite h3 {
    font-size: var(--step-2);
    font-weight: 500;
  }
  .suite__hl {
    color: var(--sand);
    font-size: var(--step--1);
  }
  .suite__meta {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* ── Why ── */
  .why {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(6rem, 16vw, 12rem);
  }
  .why__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, var(--night) 0%, rgb(11 14 26 / 0.35) 25%, rgb(11 14 26 / 0.45) 70%, var(--night) 100%);
  }
  .why__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .why h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
  }
  .why__list {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .why__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
  .why__list li {
    display: grid;
    gap: 0.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid rgb(244 241 232 / 0.35);
  }
  .why__list h3 {
    font-size: var(--step-1);
    font-weight: 700;
  }
  .why__list p {
    color: rgb(244 241 232 / 0.82);
  }

  /* ── Experiences ── */
  .exp {
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .exp__head {
    display: grid;
    gap: 0.6rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
  }
  .exp h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
  }
  .exp__head p {
    color: var(--muted);
  }
  .exp__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
  }
  @media (min-width: 900px) {
    .exp__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }
  .exp__item {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }
  .exp__item :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    margin-block-end: 0.6rem;
  }
  .exp__item h3 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.35;
  }
  .exp__item p {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* ── FAQ ── */
  .faq-wrap {
    display: grid;
    gap: 2rem;
    padding-block: clamp(4rem, 10vw, 7rem);
  }
  @media (min-width: 900px) {
    .faq-wrap {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
    }
  }
  .faq-wrap h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
  }
  .faq {
    border-block-start: 1px solid var(--line);
  }
  .faq details {
    border-block-end: 1px solid var(--line);
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.15rem;
    font-weight: 600;
    font-size: var(--step-1);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-weight: 300;
    font-size: 1.6em;
    line-height: 1;
    color: var(--sand);
    flex-shrink: 0;
    transition: transform 0.3s var(--ease-out);
  }
  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .faq details p {
    color: var(--muted);
    padding-block-end: 1.3rem;
    max-width: 44rem;
  }

  /* ── CTA ── */
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(80svh, 720px);
    display: grid;
    align-items: center;
    text-align: center;
  }
  .cta__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, var(--night) 0%, rgb(11 14 26 / 0.35) 30%, rgb(11 14 26 / 0.45) 100%);
  }
  .cta__inner {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    padding-block: 6rem;
  }
  .cta h2 {
    font-size: clamp(2.2rem, 1.4rem + 3vw, 4rem);
    font-weight: 500;
  }
  .cta p {
    color: rgb(244 241 232 / 0.85);
    font-size: var(--step-1);
  }
</style>
