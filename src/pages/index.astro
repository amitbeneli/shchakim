---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import R1Hero from '../components/R1Hero.astro';
import R4Suites from '../components/R4Suites.astro';
import R6Conditions from '../components/R6Conditions.astro';
import R7Compare from '../components/R7Compare.astro';
import R8Reviews from '../components/R8Reviews.astro';
import R10Faq from '../components/R10Faq.astro';
import { site } from '../data/site';
import { addons } from '../data/pricing';
import { photos } from '../data/images';
import { formatNumber, formatPrice } from '../lib/format';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'שחקים',
  alternateName: 'SHCHAKIM',
  description: 'לודג׳ בוטיק לתצפית כוכבים עם 9 סוויטות על שפת מכתש רמון.',
  url: Astro.site?.href,
  telephone: '+972-8-0000000',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'דרך בראשית',
    addressLocality: 'מצפה רמון',
    addressCountry: 'IL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.stats.rating,
    reviewCount: site.stats.reviews,
    bestRating: 5,
  },
  priceRange: '₪1,450-₪2,690',
  checkinTime: '15:00',
  checkoutTime: '11:00',
  numberOfRooms: site.stats.suites,
};

const reasons = [
  {
    icon: ['M30 8a14 14 0 1 0 10 24A12 12 0 0 1 30 8Z', 'M38 6v6M35 9h6', 'M42 18v3M40.5 19.5h3'],
    title: 'שמיים כהים באמת',
    text: 'אין כאן אורות עיר. בלילה בהיר שביל החלב נראה בעין, בלי טלסקופ.',
  },
  {
    icon: ['M10 25 33 12l3 5.5L13 30.5Z', 'M6.5 27.5l3.2-1.8', 'M33 12l4-2.3 3 5.5-4 2.3', 'M22 25l-7 16M22 25l7 16M22 25v16'],
    title: 'חדרים שנבנו לתצפית',
    text: 'מרפסות פתוחות, תקרות זכוכית וטלסקופים. כל סוויטה מכוונת אל השמיים.',
  },
  {
    icon: ['M24 22a6 6 0 1 0 0.01 0Z', 'M4 34c6-5 12-5 18 0s12 5 22 0', 'M4 41c8-4 16-4 24 0s10 2 16 0', 'M24 10v3M14 14l2 2M34 14l-2 2'],
    title: 'מדבר בקצב אחר',
    text: 'שקט עמוק, אוויר יבש ונוף של מכתש. מגיעים לסוף שבוע ויוצאים עם תחושה של שבוע.',
  },
];
---

<Base
  title="שחקים"
  description="לודג׳ בוטיק לתצפית כוכבים על שפת מכתש רמון. תשע סוויטות עם מרפסות פתוחות, תקרות זכוכית וטלסקופים, ויותר מ־300 לילות צלולים בשנה."
  overlayHeader
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

  <R1Hero />

  <!-- INTRO -->
  <section class="intro container" aria-labelledby="intro-title">
    <div class="intro__text">
      <h2 id="intro-title" data-reveal>כשהאור האחרון יורד אל המכתש, מתחיל כאן היום האמיתי</h2>
      <p data-reveal style="--d:1">
        שחקים הוא לודג׳ קטן על שפת מכתש רמון. תשע סוויטות, מדריכים שמכירים כל כוכב בשמו, ולילות שקטים
        כל כך שאפשר לשמוע את המדבר נושם.
      </p>
      <a href="/story" class="text-link" data-reveal style="--d:2">הסיפור שלנו</a>
    </div>
    <div class="intro__media">
      <div class="intro__a" data-reveal="clip">
        <Photo photo={photos.archDoor} sizes="(min-width: 900px) 34vw, 70vw" />
      </div>
      <div class="intro__b" data-reveal="clip" style="--d:3">
        <Photo photo={photos.lodgeNight} sizes="(min-width: 900px) 22vw, 50vw" />
      </div>
    </div>
  </section>

  <!-- STATS: numbers count up when they enter the screen -->
  <section class="stats" aria-label="שחקים במספרים">
    <dl class="container stats__list">
      <div><dt>אורחים מאז {site.openedYear}</dt><dd><bdi data-count={site.stats.guests}>{formatNumber(site.stats.guests)}</bdi></dd></div>
      <div><dt>לילות צלולים בשנה</dt><dd><bdi dir="ltr"><span data-count={site.stats.clearNights}>{site.stats.clearNights}</span>+</bdi></dd></div>
      <div><dt>דירוג מתוך {site.stats.reviews} ביקורות</dt><dd><bdi data-count={site.stats.rating} data-decimals="1">{site.stats.rating}</bdi></dd></div>
      <div><dt>סוויטות, שלושה סוגים</dt><dd><bdi data-count={site.stats.suites}>{site.stats.suites}</bdi></dd></div>
    </dl>
  </section>

  <R4Suites />

  <R6Conditions />

  <!-- WHY HERE, over the Milky Way. Icons draw themselves as you scroll. -->
  <section class="why" aria-labelledby="why-title">
    <Photo photo={photos.duneMilkyWay} class="why__img" decorative sizes="100vw" />
    <div class="why__shade" aria-hidden="true"></div>
    <div class="container why__inner">
      <h2 id="why-title" data-reveal>למה דווקא כאן</h2>
      <ul role="list" class="why__list">
        {
          reasons.map((r, i) => (
            <li data-why>
              <svg class="why__icon" viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                {r.icon.map((d) => <path d={d} pathLength="1" />)}
              </svg>
              <h3 data-reveal style={`--d:${i}`}>{r.title}</h3>
              <p data-reveal style={`--d:${i + 1}`}>{r.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <R7Compare />

  <!-- EXPERIENCES -->
  <section class="exp container" aria-labelledby="exp-title">
    <div class="exp__head" data-reveal>
      <h2 id="exp-title">מה עושים בלילה</h2>
      <p>חוויות שאפשר להוסיף לכל הזמנה.</p>
    </div>
    <ul role="list" class="exp__grid">
      {
        addons.map((a, i) => (
          <li class="exp__item" data-reveal style={`--d:${i}`}>
            <Photo photo={a.photo} sizes="(min-width: 900px) 24vw, 50vw" width={800} height={1000} />
            <h3>{a.name}</h3>
            <p>
              {a.duration}<span aria-hidden="true"> · </span>
              <bdi class="price">{formatPrice(a.price)}</bdi> {a.pricing === 'perPerson' ? 'לאדם' : 'להזמנה'}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <R8Reviews />

  <R10Faq />

  <!-- CTA -->
  <section class="cta" aria-labelledby="cta-title">
    <Photo photo={photos.canyonCandles} class="cta__img" decorative sizes="100vw" />
    <div class="cta__shade" aria-hidden="true"></div>
    <div class="container cta__inner">
      <h2 id="cta-title">הלילה הבא שלכם כבר על המפה</h2>
      <p>בוחרים תאריך, בוחרים סוויטה, ואנחנו דואגים לשאר.</p>
      <a href="/book" class="btn">להזמין לילה</a>
    </div>
  </section>
</Base>

<style>
  .why__img,
  .cta__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sand);
    font-weight: 700;
    text-decoration: none;
    padding-block: 0.4rem;
    border-block-end: 1px solid rgb(217 168 108 / 0.4);
    justify-self: start;
    transition: border-color 0.2s ease;
  }
  .text-link:hover {
    border-color: var(--sand);
  }

  /* ── Intro ── */
  .intro {
    display: grid;
    gap: 3rem;
    padding-block: clamp(5rem, 12vw, 10rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 7vw, 7rem);
    }
  }
  .intro__text {
    display: grid;
    gap: 1.5rem;
  }
  .intro h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
    line-height: 1.15;
  }
  .intro p {
    color: var(--muted);
    font-size: var(--step-1);
    max-width: 38ch;
  }
  .intro__media {
    position: relative;
    padding-block-end: 18%;
  }
  .intro__media > div {
    overflow: hidden;
    border-radius: var(--radius);
  }
  .intro__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .intro__a {
    width: 78%;
    aspect-ratio: 4 / 5;
    margin-inline-start: auto;
  }
  .intro__b {
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    width: 48%;
    aspect-ratio: 1;
    border: 6px solid var(--night);
  }

  /* ── Stats ── */
  .stats {
    border-block: 1px solid var(--line);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .stats__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.25rem 1rem;
    margin-block: 0;
  }
  @media (min-width: 768px) {
    .stats__list {
      grid-template-columns: repeat(4, 1fr);
    }
    .stats__list > div + div {
      border-inline-start: 1px solid var(--line);
      padding-inline-start: 2rem;
    }
  }
  .stats__list > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 1.6rem + 3vw, 4rem);
    line-height: 1;
    color: var(--starlight);
  }
  .stats dt {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* ── Why ── */
  .why {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(6rem, 16vw, 12rem);
  }
  .why__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, var(--night) 0%, rgb(11 14 26 / 0.35) 25%, rgb(11 14 26 / 0.45) 70%, var(--night) 100%);
  }
  .why__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .why h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
  }
  .why__list {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .why__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }
  .why__list li {
    display: grid;
    gap: 0.5rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid rgb(244 241 232 / 0.35);
  }
  .why__icon {
    width: 44px;
    height: 44px;
    color: var(--sand);
    margin-block-end: 0.5rem;
  }
  /* pathLength=1 lets one dash cover any path; JS scrubs dashoffset 1 → 0 */
  .why__icon path {
    stroke-dasharray: 1;
  }
  .why__list h3 {
    font-size: var(--step-1);
    font-weight: 700;
  }
  .why__list p {
    color: rgb(244 241 232 / 0.82);
  }

  /* ── Experiences ── */
  .exp {
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .exp__head {
    display: grid;
    gap: 0.6rem;
    margin-block-end: clamp(2rem, 5vw, 3.5rem);
  }
  .exp h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
  }
  .exp__head p {
    color: var(--muted);
  }
  .exp__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1rem;
  }
  @media (min-width: 900px) {
    .exp__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }
  .exp__item {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }
  .exp__item :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    margin-block-end: 0.6rem;
  }
  .exp__item h3 {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.35;
  }
  .exp__item p {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* ── CTA ── */
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(80svh, 720px);
    display: grid;
    align-items: center;
    text-align: center;
  }
  .cta__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, var(--night) 0%, rgb(11 14 26 / 0.35) 30%, rgb(11 14 26 / 0.45) 100%);
  }
  .cta__inner {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    padding-block: 6rem;
  }
  .cta h2 {
    font-size: clamp(2.2rem, 1.4rem + 3vw, 4rem);
    font-weight: 500;
  }
  .cta p {
    color: rgb(244 241 232 / 0.85);
    font-size: var(--step-1);
  }
</style>

<script>
  import { initHome } from '../scripts/home';
  document.addEventListener('astro:page-load', initHome);
</script>
