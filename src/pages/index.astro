---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import R1Hero from '../components/R1Hero.astro';
import Preloader from '../components/Preloader.astro';
import R4Suites from '../components/R4Suites.astro';
import R6Conditions from '../components/R6Conditions.astro';
import R7Compare from '../components/R7Compare.astro';
import R8Reviews from '../components/R8Reviews.astro';
import R10Faq from '../components/R10Faq.astro';
import BookingBar from '../components/BookingBar.astro';
import SuiteGallery from '../components/SuiteGallery.astro';
import { site } from '../data/site';
import { addons } from '../data/pricing';
import { photos, src } from '../data/images';
import { formatPrice } from '../lib/format';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: 'שחקים',
  alternateName: 'SHCHAKIM',
  description: 'לודג׳ בוטיק לתצפית כוכבים עם 9 סוויטות על שפת מכתש רמון.',
  url: Astro.site?.href,
  telephone: '+972-8-0000000',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'דרך בראשית',
    addressLocality: 'מצפה רמון',
    addressCountry: 'IL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.stats.rating,
    reviewCount: site.stats.reviews,
    bestRating: 5,
  },
  priceRange: '₪1,450-₪2,690',
  checkinTime: '15:00',
  checkoutTime: '11:00',
  numberOfRooms: site.stats.suites,
};

// "Why here": three stops along one marked trail. Icons are map symbols that draw themselves on scroll.
const stops = [
  {
    icon: ['M30 8a14 14 0 1 0 10 24A12 12 0 0 1 30 8Z', 'M38 6v6M35 9h6', 'M42 18v3M40.5 19.5h3'],
    photo: photos.heroNight,
    title: 'שמיים כהים',
    text: 'אין כאן אורות עיר. בלילה בהיר שביל החלב נראה בעין, בלי טלסקופ.',
  },
  {
    icon: ['M10 25 33 12l3 5.5L13 30.5Z', 'M6.5 27.5l3.2-1.8', 'M33 12l4-2.3 3 5.5-4 2.3', 'M22 25l-7 16M22 25l7 16M22 25v16'],
    photo: photos.kochavRoom,
    title: 'חדרים שנבנו לתצפית',
    text: 'מרפסות פתוחות, תקרות זכוכית וטלסקופים. כל סוויטה מכוונת אל השמיים.',
  },
  {
    icon: ['M4 34c6-5 12-5 18 0s12 5 22 0', 'M4 41c8-4 16-4 24 0s10 2 16 0', 'M24 22a6 6 0 1 0 0.01 0Z', 'M24 10v3M14 14l2 2M34 14l-2 2'],
    photo: photos.makhteshDeck,
    title: 'שקט של מדבר',
    text: 'אוויר יבש וצלול, בלי רעש תנועה, ונוף פתוח עד האופק.',
  },
];

// The night, by the hour: each add-on placed when it happens
const schedule: Record<string, string> = { dinner: '19:30', astronomer: '21:30', photo: '23:30', jeep: '05:15' };
const night = [...addons].sort((a, b) => ['dinner', 'astronomer', 'photo', 'jeep'].indexOf(a.id) - ['dinner', 'astronomer', 'photo', 'jeep'].indexOf(b.id));
---

<Base
  title="שחקים · סוויטות לתצפית כוכבים במכתש רמון"
  description="לודג׳ בוטיק לתצפית כוכבים על שפת מכתש רמון. תשע סוויטות עם מרפסות פתוחות, תקרות זכוכית וטלסקופים, ויותר מ־300 לילות צלולים בשנה."
  overlayHeader
  preloader
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  {/* The hero's rock layers are CSS backgrounds (masked); tell the browser about them early */}
  {
    ([['craterDusk', 800], ['craterRed', 480], ['rimCliff', 480]] as const).map(([k, w]) => (
      <link slot="head" rel="preload" as="image" href={src(photos[k], w, true)} media="(max-width: 899px)" fetchpriority="high" />
    ))
  }
  {
    (['craterDusk', 'craterRed', 'rimCliff'] as const).map((k) => (
      <link slot="head" rel="preload" as="image" href={src(photos[k], 1800, true)} media="(min-width: 900px)" />
    ))
  }

  <Preloader />
  <R1Hero />

  <!-- Phones: the availability search, right under the hero (desktop has it inside the hero) -->
  <section class="quick container" aria-labelledby="quick-title">
    <h2 id="quick-title" class="quick__title">בדיקת זמינות</h2>
    <BookingBar id="bb-quick" />
  </section>

  <!-- THE PLACE: the crater as a trail map, with the facts as its legend -->
  <section class="place" aria-labelledby="place-title">
    <figure class="plate place__photo" data-media>
      <Photo photo={photos.lodgeExterior} sizes="100vw" width={1800} height={1012} />
      <figcaption>{photos.lodgeExterior.caption}</figcaption>
    </figure>
    <div class="container place__text">
      <h2 id="place-title" data-reveal>על שפת מכתש רמון</h2>
      <p data-reveal style="--d:1">
        שחקים נמצא על השפה הצפונית של מכתש רמון, מול נוף פתוח לאורך המכתש כולו. תשע סוויטות, מדריכי תצפית
        במקום, ושמיים חשוכים ביותר מ־300 לילות בשנה.
      </p>
      <dl class="legend" data-reveal style="--d:2" aria-label="שחקים במספרים">
        <div>
          <dt>סוויטות בשלושה סוגים</dt>
          <dd><bdi data-count={site.stats.suites}>{site.stats.suites}</bdi></dd>
        </div>
        <div>
          <dt>לילות צלולים בשנה</dt>
          <dd><bdi dir="ltr"><span data-count={site.stats.clearNights}>{site.stats.clearNights}</span>+</bdi></dd>
        </div>
        <div>
          <dt>אורחים מאז {site.openedYear}</dt>
          <dd><bdi data-count={site.stats.guests}>{site.stats.guests.toLocaleString('he-IL')}</bdi></dd>
        </div>
        <div>
          <dt>דירוג ממוצע, {site.stats.reviews} ביקורות</dt>
          <dd><bdi data-count={site.stats.rating} data-decimals="1">{site.stats.rating}</bdi></dd>
        </div>
      </dl>
      <a href="/story" class="text-link" data-reveal style="--d:3">הסיפור שלנו</a>
    </div>
  </section>

  <R4Suites />

  <!-- THE PLACE IN PHOTOS: the suites and the crater around them -->
  <section class="album container section" aria-labelledby="album-title">
    <div class="album__head" data-reveal>
      <h2 id="album-title">המקום בתמונות</h2>
      <p>הסוויטות, הגג והנוף מהמרפסות.</p>
    </div>
    <SuiteGallery photos={[photos.makhteshRoom, photos.kochavRoom, photos.galaxiaRoof, photos.kochavBath, photos.makhteshDeck, photos.galaxiaLiving, photos.heroNight, photos.lodgeExterior]} name="שחקים" variant="wide" label="תמונות מהמקום" />
  </section>

  <R6Conditions />

  <!-- WHY HERE: three chapters, each a full-bleed photograph with its map symbol drawing itself -->
  <section class="why" aria-labelledby="why-title">
    <div class="container why__head">
      <h2 id="why-title" data-reveal>למה מכתש רמון</h2>
    </div>
    <ol role="list" class="why__list">
      {
        stops.map((s, i) => (
          <li class:list={['why__ch', `why__ch--${i}`]} data-why>
            <figure class="plate why__plate" data-media>
              <Photo photo={s.photo} decorative sizes="100vw" width={1800} height={1200} />
            </figure>
            <div class="why__shade" aria-hidden="true" />
            <div class="container why__copy">
              <svg class="why__icon" viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                {s.icon.map((d) => (
                  <path d={d} pathLength="1" />
                ))}
              </svg>
              <h3 data-reveal>{s.title}</h3>
              <p data-reveal style="--d:1">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <R7Compare />

  <!-- THE NIGHT, BY THE HOUR: the add-ons as a schedule, each at the time it happens -->
  <section class="night container" aria-labelledby="night-title">
    <div class="night__head" data-reveal>
      <h2 id="night-title">חוויות הלילה</h2>
      <p>אפשר להוסיף כל אחת מהן להזמנה, בשלב התוספות.</p>
    </div>
    <ol role="list" class="night__list">
      {
        night.map((a, i) => (
          <li class="night__row" data-reveal style={`--d:${i}`}>
            <time class="night__time">
              <bdi dir="ltr">{schedule[a.id]}</bdi>
            </time>
            <div class="night__body">
              <h3>{a.name}</h3>
              <p>{a.summary}</p>
              <p class="label">
                {a.duration}<span aria-hidden="true"> · </span>
                <bdi class="price">{formatPrice(a.price)}</bdi> {a.pricing === 'perPerson' ? 'לאדם' : 'להזמנה'}
              </p>
            </div>
            <figure class="plate night__plate" data-media>
              <Photo photo={a.photo} sizes="(min-width: 900px) 220px, 30vw" width={600} height={600} />
            </figure>
          </li>
        ))
      }
    </ol>
  </section>

  <R8Reviews />


  <!-- CLOSE: the real crater at sunset -->
  <section class="close" aria-labelledby="close-title">
    <figure class="plate close__plate">
      <Photo photo={photos.coupleNight} decorative sizes="100vw" width={1800} height={1012} />
    </figure>
    <div class="close__shade" aria-hidden="true"></div>
    <div class="container close__inner">
      <h2 id="close-title">הלילה הבא שלכם במכתש רמון</h2>
      <p>בוחרים תאריך וסוויטה, ואנחנו דואגים לכל השאר.</p>
      <a href="/book" class="btn">להזמין לילה</a>
      <p class="label close__cap">{photos.coupleNight.caption}</p>
    </div>
  </section>
  <R10Faq />
</Base>

<style>
  /* Phones only: the quick availability search under the hero */
  .quick {
    display: grid;
    gap: 0.9rem;
    padding-block: 2.5rem 0.5rem;
  }
  .quick__title {
    font-size: var(--fs-h3);
  }
  @media (min-width: 900px) {
    .quick {
      display: none;
    }
  }
  .album__head {
    display: grid;
    gap: 0.6rem;
    margin-block-end: clamp(1.5rem, 3vw, 2.25rem);
  }
  .album__head h2 {
    font-size: var(--fs-h2);
  }
  .album__head p {
    color: var(--muted);
    max-width: 44ch;
  }
  /* ── The place ── */
  /* An establishing shot, edge to edge, then the words and the facts beneath it */
  .place {
    padding-block: clamp(4rem, 9vw, 7rem) clamp(2.5rem, 6vw, 6rem);
  }
  .place__photo {
    aspect-ratio: 4 / 5;
    border-radius: 0;
  }
  .place__photo :global(img) {
    object-position: 70% 60%;
  }
  @media (min-width: 700px) {
    .place__photo {
      aspect-ratio: 16 / 9;
      max-height: 86svh;
      width: 100%;
    }
    .place__photo :global(img) {
      object-position: 50% 60%;
    }
  }
  .place__text {
    display: grid;
    gap: 1.5rem;
    align-content: start;
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
  }
  @media (min-width: 960px) {
    .place__text {
      grid-template-columns: 1fr 1fr;
      column-gap: clamp(2rem, 6vw, 6rem);
      align-items: start;
    }
    .place__text h2,
    .place__text > p {
      grid-column: 1;
    }
    .place__text .legend {
      grid-column: 2;
      grid-row: 1 / span 3;
    }
  }
  .place h2 {
    font-size: var(--fs-h2);
  }
  .place__text > p {
    color: var(--muted);
    font-size: var(--fs-lead);
    max-width: 38ch;
  }

  /* The business facts, set as type: large figures, a quiet label, hairlines between */
  .legend {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-block-start: 1px solid var(--line-strong);
  }
  .legend > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.45rem;
    padding: 1.4rem 0 1.4rem;
    border-block-end: 1px solid var(--line);
  }
  .legend > div:nth-child(odd) {
    padding-inline-end: 1.25rem;
  }
  .legend > div:nth-child(even) {
    padding-inline-start: 1.25rem;
    border-inline-start: 1px solid var(--line);
  }
  .legend dt {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  .legend dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 1.8vw, 3.25rem);
    line-height: 1;
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* ── Why here ── */
  .why {
    padding-block-start: clamp(4rem, 9vw, 7rem);
  }
  .why__head {
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
  }
  .why h2 {
    font-size: var(--fs-h2);
  }
  /* Each chapter is a full-bleed photograph with its copy low on the frame */
  .why__ch {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(92svh, 860px);
    display: grid;
    align-items: end;
  }
  .why__plate {
    position: absolute;
    inset: 0;
    z-index: -2;
    border-radius: 0;
  }
  .why__ch--1 .why__plate :global(img) {
    object-position: 50% 45%;
  }
  .why__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(11 14 26 / 0.55) 0%, rgb(11 14 26 / 0) 30%, rgb(11 14 26 / 0) 45%, rgb(11 14 26 / 0.88) 88%);
  }
  .why__copy {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    padding-block: 8rem clamp(3rem, 8vw, 5.5rem);
  }
  .why__ch--1 .why__copy {
    justify-items: end;
    text-align: end;
  }
  .why__copy h3 {
    font-size: var(--fs-display);
    line-height: 1.04;
    max-width: 12ch;
    text-shadow: 0 2px 24px rgb(11 14 26 / 0.5);
  }
  .why__copy p {
    font-size: var(--fs-lead);
    max-width: 34ch;
    color: rgb(244 241 232 / 0.92);
  }
  .why__icon {
    width: clamp(44px, 5vw, 60px);
    height: auto;
    color: var(--sand);
  }

  /* pathLength=1 lets one dash cover any path; JS scrubs dashoffset 1 → 0 */
  .why__icon path {
    stroke-dasharray: 1;
  }

  /* ── The night, by the hour ── */
  .night {
    padding-block: clamp(5rem, 11vw, 9rem);
  }
  .night__head {
    display: grid;
    gap: 0.75rem;
    margin-block-end: clamp(2rem, 5vw, 3rem);
  }
  .night h2 {
    font-size: var(--fs-h2);
  }
  .night__head p {
    color: var(--muted);
  }
  .night__list {
    border-block-start: 1px solid var(--line-strong);
  }
  /* Phones: time and photo share a narrow column, the text gets the rest */
  .night__row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    grid-template-areas: 'time body' 'plate body';
    grid-template-rows: auto 1fr;
    gap: 0.75rem 1.25rem;
    align-items: start;
    padding-block: 1.5rem;
    border-block-end: 1px solid var(--line);
  }
  .night__time {
    grid-area: time;
  }
  .night__body {
    grid-area: body;
  }
  .night__plate {
    grid-area: plate;
  }
  @media (min-width: 900px) {
    .night__row {
      grid-template-columns: 9rem 1fr 13rem;
      grid-template-areas: 'time body plate';
      grid-template-rows: auto;
      gap: 2.5rem;
      align-items: center;
    }
  }
  .night__time {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.75rem);
    line-height: 1;
    color: var(--sand);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .night__body {
    display: grid;
    gap: 0.35rem;
  }
  .night__body h3 {
    font-size: var(--fs-h3);
  }
  .night__body > p:not(.label) {
    color: var(--muted);
    max-width: 52ch;
  }
  .night__plate {
    aspect-ratio: 1;
  }
  .night__plate :global(img) {
    height: 100%;
  }
  @media (max-width: 899px) {
    .night__plate figcaption {
      display: none;
    }
  }

  /* ── Close ── */
  .close {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(100svh, 920px);
    display: grid;
    /* the copy sits in the starry sky above the lodge; the suites hold the lower frame */
    align-items: start;
  }
  .close__plate {
    position: absolute;
    inset: 0;
    z-index: -2;
    border-radius: 0;
  }
  .close__plate :global(img) {
    object-position: 50% 70%;
  }
  @media (min-width: 900px) {
    .close__plate :global(img) {
      object-position: 50% 60%;
    }
  }
  .close__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 45% at 75% 22%, rgb(11 14 26 / 0.55), transparent 70%),
      linear-gradient(to bottom, var(--night) 0%, rgb(11 14 26 / 0.5) 24%, rgb(11 14 26 / 0) 52%, rgb(11 14 26 / 0) 80%, var(--night) 100%);
  }
  .close__inner {
    display: grid;
    justify-items: start;
    gap: 1.1rem;
    padding-block: clamp(6rem, 14vh, 9rem) 3rem;
  }
  .close h2 {
    font-size: var(--fs-h2);
    max-width: 14ch;
  }
  .close p:not(.label) {
    font-size: var(--fs-lead);
    color: rgb(244 241 232 / 0.9);
  }
  .close__inner h2,
  .close__inner p {
    text-shadow: 0 1px 3px rgb(11 14 26 / 0.7), 0 0 24px rgb(11 14 26 / 0.5);
  }
  /* the photo credit sits low, on the dark rock, away from the sunset band */
  .close__cap {
    position: absolute;
    inset-block-end: 1.25rem;
    inset-inline-start: var(--gutter);
    color: rgb(244 241 232 / 0.85);
  }
</style>

<script>
  import { initHome } from '../scripts/home';
  document.addEventListener('astro:page-load', initHome);
</script>
