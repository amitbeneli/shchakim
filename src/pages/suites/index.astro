---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import { suites } from '../../data/pricing';
import { photos } from '../../data/images';
import { formatPrice } from '../../lib/format';

// One editorial row per suite (large photo, a second view inset, the facts and two
// actions), then a side-by-side comparison, the way hotel room pages are read.
const unitWord = (slug: string) => (slug === 'galaxia' ? 'וילות' : 'סוויטות');
---

<Base
  title="הסוויטות"
  description="סוויטת מכתש, סוויטת כוכב ווילת גלקסיה. שלוש דרכים לישון מתחת לשמיים של מכתש רמון, מ־1,450 ₪ ללילה."
  overlayHeader
>
  <PageHero
    photo={photos.lodgeExterior}
    title="הסוויטות"
    lead="תשע סוויטות בשלושה סוגים, כולן על שפת המצוק ופונות אל המכתש."
    focus="62% 60%"
  />

  <ol role="list" class="rooms container">
    {
      suites.map((s, i) => (
        <li class:list={['room', { 'room--flip': i % 2 === 1 }]}>
          <div class="room__media">
            <figure class="plate room__main" data-media transition:name={`suite-media-${s.slug}`}>
              <Photo photo={s.photo} sizes="(min-width: 960px) 58vw, 100vw" width={1500} height={1000} />
            </figure>
            <figure class="plate room__inset" aria-hidden="true">
              <Photo photo={s.gallery[1]} decorative sizes="(min-width: 960px) 20vw, 40vw" width={800} height={800} />
            </figure>
          </div>
          <div class="room__body">
            <h2>{s.name}</h2>
            <p class="room__hl">{s.highlight}</p>
            <p class="room__sum">{s.summary}</p>
            <ul role="list" class="room__chips">
              {s.amenities.slice(0, 4).map((a) => <li>{a}</li>)}
            </ul>
            <dl class="room__facts">
              <div>
                <dt>אורחים</dt>
                <dd>עד {s.maxGuests}</dd>
              </div>
              <div>
                <dt>במקום</dt>
                <dd>
                  {s.units} {unitWord(s.slug)}
                </dd>
              </div>
              <div>
                <dt>החל מ־</dt>
                <dd>
                  <bdi class="room__price">{formatPrice(s.nightly)}</bdi> ללילה
                </dd>
              </div>
            </dl>
            <div class="room__actions">
              <a href={`/book?suite=${s.slug}`} class="btn">
                להזמין<span class="visually-hidden"> את {s.name}</span>
              </a>
              <a href={`/suites/${s.slug}`} class="btn btn--ghost">
                לפרטים ולתמונות<span class="visually-hidden"> של {s.name}</span>
              </a>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <section class="compare container section" aria-labelledby="compare-title">
    <h2 id="compare-title" data-reveal>להשוות בין הסוויטות</h2>
    <div class="compare__scroll" data-reveal>
      <table class="compare__table">
        <thead>
          <tr>
            <td></td>
            {suites.map((s) => <th scope="col">{s.name}</th>)}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">מה מיוחד</th>
            {suites.map((s) => <td>{s.highlight}</td>)}
          </tr>
          <tr>
            <th scope="row">אורחים</th>
            {suites.map((s) => <td>עד {s.maxGuests}</td>)}
          </tr>
          <tr>
            <th scope="row">במקום</th>
            {
              suites.map((s) => (
                <td>
                  {s.units} {unitWord(s.slug)}
                </td>
              ))
            }
          </tr>
          <tr>
            <th scope="row">ללילה, כולל מע״מ</th>
            {
              suites.map((s) => (
                <td>
                  <bdi class="room__price">{formatPrice(s.nightly)}</bdi>
                </td>
              ))
            }
          </tr>
          <tr>
            <th scope="row"><span class="visually-hidden">הזמנה</span></th>
            {
              suites.map((s) => (
                <td>
                  <a href={`/book?suite=${s.slug}`} class="text-link">
                    להזמין<span class="visually-hidden"> את {s.name}</span>
                  </a>
                </td>
              ))
            }
          </tr>
        </tbody>
      </table>
    </div>
    <p class="compare__note">לילות חמישי ושישי בתוספת 20%. הזמנה שכוללת לילה של חמישי או שישי היא לפחות שני לילות.</p>
  </section>
</Base>

<style>
  .rooms {
    display: grid;
    gap: clamp(4.5rem, 10vw, 8rem);
    padding-block: clamp(4rem, 9vw, 7rem) 0;
  }
  .room {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .room {
      grid-template-columns: 1.35fr 1fr;
    }
    .room--flip .room__media {
      order: 2;
    }
  }
  .room__media {
    position: relative;
    padding-block-end: clamp(2rem, 6vw, 4rem);
  }
  .room__main {
    aspect-ratio: 3 / 2;
  }
  /* A second view, overlapping the corner like a print laid on a print */
  .room__inset {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: clamp(-1rem, -2vw, -0.5rem);
    width: 34%;
    aspect-ratio: 1;
    border: 4px solid var(--night);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
  }
  .room--flip .room__inset {
    inset-inline-end: auto;
    inset-inline-start: clamp(-1rem, -2vw, -0.5rem);
  }
  @media (max-width: 959px) {
    .room__inset,
    .room--flip .room__inset {
      inset-inline-end: 0.75rem;
      inset-inline-start: auto;
      width: 36%;
    }
  }
  .room__body {
    display: grid;
    align-content: start;
    gap: 1rem;
  }
  .room h2 {
    font-size: var(--fs-h2);
    line-height: 1.05;
  }
  .room__hl {
    color: var(--sand);
    font-size: var(--fs-lead);
  }
  .room__sum {
    color: var(--muted);
    max-width: 40ch;
  }
  .room__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .room__chips li {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: var(--fs-small);
  }
  .room__facts {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 0.5rem clamp(1.5rem, 4vw, 2.5rem);
    margin: 0.5rem 0 0;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }
  .room__facts dt {
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--sand);
  }
  .room__facts dd {
    margin: 0;
  }
  .room__price {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  .room__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }

  /* the table scrolls inside its frame; nothing in this section may widen the page */
  .compare {
    overflow-x: clip;
  }
  .compare h2 {
    font-size: var(--fs-h2);
    margin-block-end: clamp(1.5rem, 4vw, 2.25rem);
  }
  .compare__scroll {
    overflow-x: auto;
    min-width: 0;
    max-width: calc(100vw - 2 * var(--gutter));
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }
  .compare__table {
    width: 100%;
    border-collapse: collapse;
  }
  .compare__table th,
  .compare__table td {
    padding: 0.8rem 0.55rem;
    font-size: var(--fs-small);
    text-align: start;
    vertical-align: top;
    border-block-end: 1px solid var(--line);
  }
  .compare__table tr:last-child > * {
    border-block-end: 0;
  }
  .compare__table thead th {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-h3);
  }
  @media (min-width: 700px) {
    .compare__table th,
    .compare__table td {
      padding: 1rem 1.1rem;
      font-size: var(--fs-body);
    }
  }
  .compare__table tbody th {
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--sand);
  }
  .compare__note {
    margin-block-start: 1rem;
    color: var(--muted);
    font-size: var(--fs-small);
  }
</style>

<script>
  import { initMedia } from '../../scripts/media';
  document.addEventListener('astro:page-load', () => {
    if (!document.querySelector('.rooms')) return;
    const stop = initMedia();
    document.addEventListener('astro:before-swap', stop, { once: true });
  });
</script>
