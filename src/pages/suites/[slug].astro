---
import Base from '../../layouts/Base.astro';
import { suites, type Suite } from '../../data/pricing';
import { formatPrice } from '../../lib/format';
import SuiteGallery from '../../components/SuiteGallery.astro';
import PageHero from '../../components/PageHero.astro';
import SuiteCard from '../../components/SuiteCard.astro';

export function getStaticPaths() {
  return suites.map((suite) => ({ params: { slug: suite.slug }, props: { suite } }));
}

interface Props {
  suite: Suite;
}
const { suite } = Astro.props;
const others = suites.filter((s) => s.slug !== suite.slug);
---

<Base title={suite.name} description={`${suite.name}: ${suite.summary} עד ${suite.maxGuests} אורחים, ${formatPrice(suite.nightly)} ללילה.`} overlayHeader>
  <PageHero photo={suite.photo} title={suite.name} lead={suite.summary} id="suite-title" transitionName={`suite-media-${suite.slug}`}>
    <a href="/suites" class="back" slot="top">
      <svg class="icon-back" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
        <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      כל הסוויטות
    </a>
  </PageHero>

  <!-- Under the photo: what makes it special, the practical facts in one line, and the price with its action -->
  <div class="container intro">
    <div class="intro__text">
      <p class="intro__hl">{suite.highlight}</p>
      <ul role="list" class="intro__meta">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm8 0a3 3 0 1 0 0-6M2.5 20c.6-3.4 2.8-5.5 5.5-5.5s4.9 2.1 5.5 5.5M15 14.6c2.6.2 4.4 2.1 4.9 5.4" /></svg>עד {suite.maxGuests} אורחים</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13.5V12l3 2" /></svg>צ׳ק־אין מ־<bdi dir="ltr">15:00</bdi><span aria-hidden="true"> · </span>יציאה עד <bdi dir="ltr">11:00</bdi></li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V9.5L12 4l8 5.5V20M9.5 20v-5.5h5V20" /></svg>{suite.units} יחידות במתחם</li>
      </ul>
    </div>
    <div class="intro__book">
      <p class="intro__price"><span>החל מ־</span><bdi>{formatPrice(suite.nightly)}</bdi><span>ללילה, כולל מע״מ</span></p>
      <a href={`/book?suite=${suite.slug}`} class="btn">להזמין עכשיו</a>
    </div>
  </div>

  <section class="container suite-gallery" aria-labelledby="view-title">
    <h2 id="view-title" class="suite-sub">גלריה</h2>
    <SuiteGallery photos={suite.gallery} name={suite.name} />
  </section>

  <div class="container suite-body">
    <div class="suite-main">
      <div class="prose">
        {suite.description.map((p) => <p>{p}</p>)}
      </div>

      <h2 class="suite-sub">מה כולל</h2>
      <ul role="list" class="amenities">
        {suite.amenities.map((a) => <li>{a}</li>)}
      </ul>

    </div>

    <aside class="suite-book" aria-label="הזמנה">
      <p class="suite-book__price">
        <bdi class="price">{formatPrice(suite.nightly)}</bdi>
        <span>ללילה, כולל מע״מ</span>
      </p>
      <p class="suite-book__note">עד {suite.maxGuests} אורחים. לילות חמישי ושישי בתוספת 20%.</p>
      <a href={`/book?suite=${suite.slug}`} class="btn">להזמין את {suite.name}</a>
    </aside>
  </div>

  <section class="container section others" aria-labelledby="others-title">
    <h2 id="others-title" class="suite-sub">סוויטות נוספות</h2>
    <ul role="list" class="others__grid">
      {others.map((s) => <li><SuiteCard suite={s} /></li>)}
    </ul>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(2rem, 5vw, 3.25rem);
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 3rem;
    }
  }
  .intro__text {
    display: grid;
    gap: 1rem;
  }
  .intro__hl {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.1rem + 2vw, 2.5rem);
    line-height: 1.2;
    color: var(--sand);
  }
  .intro__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    color: var(--muted);
  }
  .intro__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .intro__meta svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--sand);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }
  .intro__book {
    display: flex;
    align-items: end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .intro__price {
    display: grid;
    line-height: 1.2;
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .intro__price bdi {
    font-family: var(--font-display);
    font-size: 2.1rem;
    color: var(--starlight);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    justify-self: start;
    text-decoration: none;
    color: var(--muted);
    padding-block: 0.5rem;
  }
  /* "Back" points right in RTL — the chevron path above already points right */
  .back:hover {
    color: var(--starlight);
  }

  .suite-gallery {
    padding-block-start: clamp(1rem, 3vw, 2rem);
  }
  .suite-gallery .suite-sub {
    margin-block-start: 0;
  }
  .suite-body {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 900px) {
    .suite-body {
      grid-template-columns: 1fr 22rem;
      align-items: start;
    }
  }
  .suite-sub {
    font-size: var(--fs-h3);
    margin-block: 2.5rem 1rem;
  }
  .amenities {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 600px) {
    .amenities {
      grid-template-columns: 1fr 1fr;
    }
  }
  .amenities li {
    padding-inline-start: 1.25rem;
    position: relative;
  }
  .amenities li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.7em;
    width: 7px;
    height: 7px;
    background: var(--sand);
    transform: rotate(45deg);
  }

  .suite-book {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--night-2);
  }
  @media (min-width: 900px) {
    .suite-book {
      position: sticky;
      inset-block-start: calc(var(--header-h) + 1.5rem);
    }
  }
  .suite-book__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .suite-book__price .price {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    color: var(--sand);
  }
  .suite-book__price span,
  .suite-book__note {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .others {
    padding-block-start: 0;
  }
  .others__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 2.5rem);
  }
  @media (min-width: 768px) {
    .others__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
