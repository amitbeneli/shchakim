---
import Base from '../../layouts/Base.astro';
import { suites, type Suite } from '../../data/pricing';
import { formatPrice } from '../../lib/format';
import SuiteDrawing from '../../components/SuiteDrawing.astro';
import SuiteGallery from '../../components/SuiteGallery.astro';

export function getStaticPaths() {
  return suites.map((suite) => ({ params: { slug: suite.slug }, props: { suite } }));
}

interface Props {
  suite: Suite;
}
const { suite } = Astro.props;
const others = suites.filter((s) => s.slug !== suite.slug);
---

<Base title={suite.name} description={`${suite.name}: ${suite.summary} עד ${suite.maxGuests} אורחים, ${formatPrice(suite.nightly)} ללילה.`}>
  <section class="suite-hero container" aria-labelledby="suite-title">
    <div class="suite-hero__text">
      <a href="/suites" class="back">
        <svg class="icon-back" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
          <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        כל הסוויטות
      </a>
      <h1 id="suite-title">{suite.name}</h1>
      <p class="suite-hero__hl">{suite.highlight}</p>
      <p class="suite-hero__sum">{suite.summary}</p>
    </div>
    <div class="suite-hero__sheet" transition:name={`suite-media-${suite.slug}`}>
      <SuiteDrawing slug={suite.slug} />
    </div>
  </section>

  <section class="container suite-gallery" aria-labelledby="view-title">
    <h2 id="view-title" class="suite-sub">הנוף מהסוויטה</h2>
    <SuiteGallery photos={suite.gallery} name={suite.name} />
  </section>

  <div class="container suite-body">
    <div class="suite-main">
      <div class="prose">
        {suite.description.map((p) => <p>{p}</p>)}
      </div>

      <h2 class="suite-sub">מה יש בסוויטה</h2>
      <ul role="list" class="amenities">
        {suite.amenities.map((a) => <li>{a}</li>)}
      </ul>
    </div>

    <aside class="suite-book" aria-label="הזמנה">
      <p class="suite-book__price">
        <bdi class="price">{formatPrice(suite.nightly)}</bdi>
        <span>ללילה, כולל מע״מ</span>
      </p>
      <p class="suite-book__note">עד {suite.maxGuests} אורחים. לילות חמישי ושישי בתוספת 20%.</p>
      <a href={`/book?suite=${suite.slug}`} class="btn">להזמין את הסוויטה הזו</a>
    </aside>
  </div>

  <section class="container section others" aria-labelledby="others-title">
    <h2 id="others-title" class="suite-sub">סוויטות נוספות</h2>
    <ul role="list">
      {
        others.map((s) => (
          <li>
            <a href={`/suites/${s.slug}`}>
              <span>{s.name}</span>
              <span class="others__meta">{s.highlight}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .suite-hero {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-block: calc(var(--header-h) + clamp(2rem, 6vw, 4.5rem)) clamp(2rem, 5vw, 3.5rem);
  }
  @media (min-width: 900px) {
    .suite-hero {
      grid-template-columns: 1fr 1.35fr;
      gap: clamp(2rem, 5vw, 5rem);
    }
  }
  .suite-hero__text {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .suite-hero h1 {
    font-size: var(--fs-display);
    line-height: 1.02;
  }
  .suite-hero__hl {
    color: var(--sand);
    font-size: var(--fs-lead);
  }
  .suite-hero__sum {
    color: var(--muted);
    max-width: 36ch;
  }
  /* The drawing sheet morphs from the card (shared-element view transition) */
  .suite-hero__sheet {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3.2;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background:
      linear-gradient(rgb(16 20 42 / 0.82), rgb(16 20 42 / 0.82)),
      url(/topo.svg) center / 200% auto,
      var(--night-2);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    justify-self: start;
    text-decoration: none;
    color: var(--muted);
    padding-block: 0.5rem;
  }
  /* "Back" points right in RTL — the chevron path above already points right */
  .back:hover {
    color: var(--starlight);
  }

  .suite-gallery {
    padding-block-start: clamp(1rem, 3vw, 2rem);
  }
  .suite-gallery .suite-sub {
    margin-block-start: 0;
  }
  .suite-body {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 900px) {
    .suite-body {
      grid-template-columns: 1fr 22rem;
      align-items: start;
    }
  }
  .suite-sub {
    font-size: var(--fs-h3);
    margin-block: 2.5rem 1rem;
  }
  .amenities {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 600px) {
    .amenities {
      grid-template-columns: 1fr 1fr;
    }
  }
  .amenities li {
    padding-inline-start: 1.25rem;
    position: relative;
  }
  .amenities li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.7em;
    width: 7px;
    height: 7px;
    background: var(--sand);
    transform: rotate(45deg);
  }

  .suite-book {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--night-2);
  }
  @media (min-width: 900px) {
    .suite-book {
      position: sticky;
      inset-block-start: calc(var(--header-h) + 1.5rem);
    }
  }
  .suite-book__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .suite-book__price .price {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    color: var(--sand);
  }
  .suite-book__price span,
  .suite-book__note {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .others {
    padding-block-start: 0;
  }
  .others ul {
    border-block-start: 1px solid var(--line);
  }
  .others a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-block: 1.1rem;
    border-block-end: 1px solid var(--line);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
  }
  .others__meta {
    font-family: var(--font-body);
    font-size: var(--step--1);
    color: var(--muted);
    align-self: center;
  }
  .others a:hover span:first-child {
    color: var(--sand);
  }
</style>
