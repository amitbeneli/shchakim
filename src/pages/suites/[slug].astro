---
import Base from '../../layouts/Base.astro';
import { suites, type Suite } from '../../data/pricing';
import { formatPrice } from '../../lib/format';
import SuiteDrawing from '../../components/SuiteDrawing.astro';
import SuiteGallery from '../../components/SuiteGallery.astro';
import PageHero from '../../components/PageHero.astro';
import SuiteCard from '../../components/SuiteCard.astro';

export function getStaticPaths() {
  return suites.map((suite) => ({ params: { slug: suite.slug }, props: { suite } }));
}

interface Props {
  suite: Suite;
}
const { suite } = Astro.props;
const others = suites.filter((s) => s.slug !== suite.slug);
---

<Base title={suite.name} description={`${suite.name}: ${suite.summary} עד ${suite.maxGuests} אורחים, ${formatPrice(suite.nightly)} ללילה.`} overlayHeader>
  <PageHero photo={suite.photo} title={suite.name} lead={suite.summary} id="suite-title" transitionName={`suite-media-${suite.slug}`}>
    <a href="/suites" class="back" slot="top">
      <svg class="icon-back" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
        <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      כל הסוויטות
    </a>
  </PageHero>

  <!-- The facts a guest checks before anything else, in one line -->
  <div class="container facts-wrap">
    <dl class="facts">
      <div>
        <dt>מה מיוחד</dt>
        <dd>{suite.highlight}</dd>
      </div>
      <div>
        <dt>אורחים</dt>
        <dd>עד {suite.maxGuests}</dd>
      </div>
      <div>
        <dt>צ׳ק־אין / אאוט</dt>
        <dd><bdi dir="ltr">15:00</bdi> / <bdi dir="ltr">11:00</bdi></dd>
      </div>
      <div>
        <dt>החל מ־</dt>
        <dd><bdi class="facts__price">{formatPrice(suite.nightly)}</bdi> ללילה</dd>
      </div>
    </dl>
    <p class="facts__cta">
      <a href={`/book?suite=${suite.slug}`} class="btn">להזמין את הסוויטה</a>
    </p>
  </div>

  <section class="container suite-gallery" aria-labelledby="view-title">
    <h2 id="view-title" class="suite-sub">הסוויטה בתמונות</h2>
    <SuiteGallery photos={suite.gallery} name={suite.name} />
  </section>

  <div class="container suite-body">
    <div class="suite-main">
      <div class="prose">
        {suite.description.map((p) => <p>{p}</p>)}
      </div>

      <h2 class="suite-sub">מה יש בסוויטה</h2>
      <ul role="list" class="amenities">
        {suite.amenities.map((a) => <li>{a}</li>)}
      </ul>

      <h2 class="suite-sub">חתך הסוויטה</h2>
      <figure class="suite-plan">
        <SuiteDrawing slug={suite.slug} />
        <figcaption>חתך דרך הסוויטה ושפת המצוק. כך היא יושבת מול המכתש.</figcaption>
      </figure>
    </div>

    <aside class="suite-book" aria-label="הזמנה">
      <p class="suite-book__price">
        <bdi class="price">{formatPrice(suite.nightly)}</bdi>
        <span>ללילה, כולל מע״מ</span>
      </p>
      <p class="suite-book__note">עד {suite.maxGuests} אורחים. לילות חמישי ושישי בתוספת 20%.</p>
      <a href={`/book?suite=${suite.slug}`} class="btn">להזמין את הסוויטה הזו</a>
    </aside>
  </div>

  <section class="container section others" aria-labelledby="others-title">
    <h2 id="others-title" class="suite-sub">סוויטות נוספות</h2>
    <ul role="list" class="others__grid">
      {others.map((s) => <li><SuiteCard suite={s} /></li>)}
    </ul>
  </section>
</Base>

<style>
  .facts-wrap {
    display: grid;
    gap: 1.1rem 2rem;
    padding-block: clamp(1.5rem, 3vw, 2rem);
    border-block-end: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .facts-wrap {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.1rem 1.5rem;
    margin: 0;
  }
  @media (min-width: 900px) {
    .facts {
      grid-template-columns: 1.6fr repeat(3, auto);
      align-items: end;
    }
  }
  .facts dt {
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--sand);
  }
  .facts dd {
    margin: 0.2rem 0 0;
  }
  .facts__price {
    font-family: var(--font-display);
    font-size: 1.5rem;
  }
  .facts__cta {
    margin: 0;
  }
  .facts__cta .btn {
    white-space: nowrap;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    justify-self: start;
    text-decoration: none;
    color: var(--muted);
    padding-block: 0.5rem;
  }
  /* "Back" points right in RTL — the chevron path above already points right */
  .back:hover {
    color: var(--starlight);
  }

  .suite-gallery {
    padding-block-start: clamp(1rem, 3vw, 2rem);
  }
  .suite-gallery .suite-sub {
    margin-block-start: 0;
  }
  .suite-body {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 900px) {
    .suite-body {
      grid-template-columns: 1fr 22rem;
      align-items: start;
    }
  }
  .suite-sub {
    font-size: var(--fs-h3);
    margin-block: 2.5rem 1rem;
  }
  .amenities {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 600px) {
    .amenities {
      grid-template-columns: 1fr 1fr;
    }
  }
  .amenities li {
    padding-inline-start: 1.25rem;
    position: relative;
  }
  .amenities li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.7em;
    width: 7px;
    height: 7px;
    background: var(--sand);
    transform: rotate(45deg);
  }

  .suite-book {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--night-2);
  }
  @media (min-width: 900px) {
    .suite-book {
      position: sticky;
      inset-block-start: calc(var(--header-h) + 1.5rem);
    }
  }
  .suite-book__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .suite-book__price .price {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    color: var(--sand);
  }
  .suite-book__price span,
  .suite-book__note {
    color: var(--muted);
    font-size: var(--step--1);
  }

  .others {
    padding-block-start: 0;
  }
  .others__grid {
    display: grid;
    gap: clamp(2rem, 4vw, 2.5rem);
  }
  @media (min-width: 768px) {
    .others__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
