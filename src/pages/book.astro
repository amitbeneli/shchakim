---
import Base from '../layouts/Base.astro';
import Wizard from '../components/booking/Wizard';
import '../styles/booking.css';
---

<Base
  title="הזמנה"
  description="הזמנת לילה בשחקים: בוחרים תאריכים, סוויטה וחוויות, ומקבלים פירוט מחיר מלא. בלי תשלום מראש."
  hideFab
>
  <div class="page book container">
    <header class="book__head">
      <h1>הזמנת לילה</h1>
      <p>חמישה שלבים קצרים. אין תשלום עכשיו, ונחזור אליכם לאישור תוך יום.</p>
    </header>

    <Wizard client:load />

    <noscript>
      <p class="book__noscript">
        כדי להזמין באתר צריך JavaScript. אפשר גם להתקשר אלינו: <bdi dir="ltr">08-0000000</bdi>
      </p>
    </noscript>
  </div>
</Base>

<style>
  .book {
    padding-block-start: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem));
  }
  .book__head {
    display: grid;
    gap: 0.6rem;
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 40rem;
  }
  .book__head h1 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 500;
  }
  .book__head p:last-child {
    color: var(--muted);
  }
  .book__noscript {
    padding: 1rem;
    border: 1px solid var(--sand);
    border-radius: var(--radius);
  }
</style>
