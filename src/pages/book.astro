---
import Base from '../layouts/Base.astro';
import { suites } from '../data/pricing';
import { site } from '../data/site';
import { formatPrice } from '../lib/format';
---

<Base
  title="הזמנה"
  description="הזמנת לילה בשחקים: בוחרים תאריכים, סוויטה וחוויות, ומקבלים פירוט מחיר מלא. בלי תשלום מראש."
  hideFab
>
  <div class="page container">
    <header class="page-head">
      <p class="eyebrow">הזמנה</p>
      <h1>לשריין לילה</h1>
      <p>בוחרים תאריכים, סוויטה וחוויות. לא גובים תשלום בשלב הזה, ונחזור אליכם לאישור תוך יום.</p>
    </header>

    <!-- Stage 2 replaces this with the 5-step wizard (src/components/BookingWizard). -->
    <div class="book-stub" data-book-stub>
      <p class="book-stub__picked" data-picked hidden></p>
      <ul role="list" class="book-suites">
        {
          suites.map((s) => (
            <li data-suite={s.slug}>
              <span class="book-suites__name">{s.name}</span>
              <span class="book-suites__meta">
                עד {s.maxGuests} אורחים · <bdi class="price">{formatPrice(s.nightly)}</bdi> ללילה
              </span>
            </li>
          ))
        }
      </ul>
      <p class="book-stub__phone">
        בינתיים אפשר להזמין בטלפון:
        <a href={site.phoneHref}><bdi dir="ltr">{site.phone}</bdi></a>
      </p>
    </div>
  </div>
</Base>

<style>
  .book-stub {
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
  }
  .book-stub__picked {
    padding: 1rem 1.25rem;
    border: 1px solid var(--sand);
    border-radius: var(--radius);
    color: var(--sand);
  }
  .book-suites {
    border-block-start: 1px solid var(--line);
  }
  .book-suites li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-block: 1rem;
    border-block-end: 1px solid var(--line);
  }
  .book-suites li.is-picked .book-suites__name {
    color: var(--sand);
  }
  .book-suites__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 700;
  }
  .book-suites__meta {
    color: var(--muted);
    font-size: var(--step--1);
    align-self: center;
  }
  .book-stub__phone a {
    color: var(--sand);
  }
</style>

<script>
  import { getSuite } from '../data/pricing';

  // Pre-fill from ?suite=…&date=YYYY-MM-DD (the wizard in stage 2 keeps this contract)
  document.addEventListener('astro:page-load', () => {
    const box = document.querySelector('[data-book-stub]');
    if (!box) return;
    const params = new URLSearchParams(location.search);
    const suite = getSuite(params.get('suite') ?? '');
    const date = params.get('date');
    const validDate = date && /^\d{4}-\d{2}-\d{2}$/.test(date) ? new Date(`${date}T12:00:00`) : null;

    const parts: string[] = [];
    if (suite) {
      parts.push(`בחרתם ב${suite.name}`);
      box.querySelector(`[data-suite="${suite.slug}"]`)?.classList.add('is-picked');
    }
    if (validDate && !Number.isNaN(validDate.getTime())) {
      parts.push(
        `ללילה של ${validDate.toLocaleDateString('he-IL', { weekday: 'long', day: 'numeric', month: 'long' })}`,
      );
    }
    const picked = box.querySelector<HTMLElement>('[data-picked]');
    if (picked && parts.length) {
      picked.textContent = parts.join(' ') + '.';
      picked.hidden = false;
    }
  });
</script>
