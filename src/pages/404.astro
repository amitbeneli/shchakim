---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { photos } from '../data/images';
---

<Base title="העמוד לא נמצא" description="העמוד שחיפשתם לא נמצא. אפשר לחזור לדף הבית או לראות את הסוויטות." noindex>
  <section class="nf">
    <figure class="plate nf__plate"><Photo photo={photos.heroNight} decorative eager sizes="100vw" /></figure>
    <div class="nf__shade" aria-hidden="true"></div>
    <div class="container nf__inner">
      <p class="nf__code" aria-hidden="true"><bdi>404</bdi></p>
      <h1>הכוכב הזה כבר כבה</h1>
      <p>האור שלו עוד הגיע אליכם, אבל העמוד עצמו כבר לא כאן. אולי הקישור השתנה.</p>
      <div class="nf__actions">
        <a href="/" class="btn">חזרה לדף הבית</a>
        <a href="/suites" class="btn btn--ghost">לראות את הסוויטות</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf__plate {
    position: absolute;
    inset: 0;
    z-index: -2;
    border-radius: 0;
  }
  .nf__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to bottom, rgb(11 14 26 / 0.7), rgb(11 14 26 / 0.55) 40%, var(--night));
  }
  .nf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: calc(var(--header-h) + 2rem) 10rem;
  }
  .nf__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    max-width: 36rem;
    margin-inline: auto;
  }
  .nf__code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 10vw, 9rem);
    font-weight: 500;
    line-height: 1;
    color: var(--sand);
    opacity: 0.9;
  }
  .nf h1 {
    font-size: var(--step-3);
  }
  .nf p {
    color: var(--muted);
  }
  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }
</style>
