---
// R1: day to night, drawn as a trail map's elevation profile across the crater.
// The section is taller than the screen; its stage is position:sticky and GSAP
// scrubs one timeline against scroll (sticky, not GSAP pin: steadier on iOS).
// Layers: night sky + canvas stars (end state), dusk and gold washes (start
// state), the sun, and three ridge profiles hatched like map contours.

const words = ['לילה', 'אחד', 'מתחת', 'לשמיים', 'שלמים'];

// Ridge profiles (viewBox 1440×300). Back = far crater wall, front = the rim you stand on.
const back = 'M0 92 C 120 70 210 40 330 48 S 520 96 640 88 S 820 30 930 36 S 1130 92 1250 80 S 1390 54 1440 60 V300 H0Z';
const mid = 'M0 150 C 160 128 280 112 420 120 S 640 168 790 158 S 1010 104 1140 112 S 1360 150 1440 146 V300 H0Z';
const front = 'M0 214 C 200 200 330 186 500 194 S 760 226 940 218 S 1220 190 1440 200 V300 H0Z';
---

<section class="r1" data-hero data-r1 aria-labelledby="hero-title">
  <div class="r1__stage">
    <div class="r1__night" data-r1-night></div>
    <canvas class="r1__stars" data-r1-stars></canvas>
    <div class="r1__dusk" data-r1-dusk></div>
    <div class="r1__gold" data-r1-gold></div>
    <div class="r1__sun" data-r1-sun><span></span></div>

    <svg class="r1__ridges" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <!-- Contour hatching: the engraved lines of a printed profile -->
        <pattern id="r1-hatch" width="12" height="9" patternUnits="userSpaceOnUse">
          <path d="M0 8.5 H12" stroke="#d9a86c" stroke-opacity="0.22" stroke-width="1"></path>
        </pattern>
      </defs>
      <g data-r1-ridge="back">
        <path d={back} class="r1__fill r1__fill--back"></path>
        <path d={back} fill="url(#r1-hatch)"></path>
        <path d={back} class="r1__crest"></path>
      </g>
      <g data-r1-ridge="mid">
        <path d={mid} class="r1__fill r1__fill--mid"></path>
        <path d={mid} fill="url(#r1-hatch)"></path>
        <path d={mid} class="r1__crest"></path>
      </g>
      <g data-r1-ridge="front">
        <path d={front} class="r1__fill r1__fill--front"></path>
        <path d={front} class="r1__crest r1__crest--front"></path>
      </g>
    </svg>

    <!-- Map furniture: the elevation axis -->
    <div class="r1__axis" aria-hidden="true">
      <span>900 מ׳</span>
      <span>850 מ׳</span>
      <span>800 מ׳</span>
    </div>

    <div class="container r1__copy">
      <h1 id="hero-title" class="r1__title" aria-label={words.join(' ')}>
        {words.map((w, i) => (
          <span class="r1__word" style={`--i:${i}`} aria-hidden="true">{w}</span>
        ))}
      </h1>
      <p class="r1__lead">תשע סוויטות על שפת מכתש רמון, בנויות לדבר אחד: להסתכל למעלה.</p>
      <div class="r1__actions">
        <a href="/book" class="btn">להזמין לילה</a>
        <a href="/suites" class="btn btn--ghost">הסוויטות</a>
      </div>
      <p class="r1__coords label"><bdi dir="ltr">30°36′N 34°48′E</bdi> · מצפה רמון, שפת המכתש</p>
    </div>
  </div>
</section>

<style>
  .r1 {
    position: relative;
    height: 210svh;
  }
  @media (max-width: 767px) {
    .r1 {
      height: 175svh;
    }
  }
  .r1__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--night);
  }
  .r1__stage > * {
    position: absolute;
  }

  /* Night (end state): deep sky with a low glow along the horizon */
  .r1__night {
    inset: -5% 0 0;
    background:
      radial-gradient(120% 60% at 70% 85%, rgb(42 30 63 / 0.85), transparent 70%),
      linear-gradient(to bottom, #070914 0%, var(--night) 55%, #141127 100%);
    will-change: transform;
  }
  .r1__stars {
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  /* Dusk fades second (purple → night) */
  .r1__dusk {
    inset: 0;
    background: linear-gradient(to bottom, #1a1430 0%, var(--dusk) 38%, #5b2f4d 70%, #9a4a43 100%);
  }
  /* Gold fades first (ember → purple) */
  .r1__gold {
    inset: 0;
    background: linear-gradient(to bottom, #2a1e3f 0%, #7a3a4c 32%, #c75a3c 58%, var(--ember) 70%, #f0a25e 86%);
  }

  .r1__sun {
    inset-inline-start: 74%;
    top: 46%;
    --sun: clamp(90px, 11vw, 150px);
    width: var(--sun);
    aspect-ratio: 1;
    /* centre with margins, not translate: GSAP owns the transform */
    margin-inline-start: calc(var(--sun) / -2);
    margin-block-start: calc(var(--sun) / -2);
    will-change: transform, opacity;
  }
  @media (max-width: 767px) {
    .r1__sun {
      inset-inline-start: 72%;
      top: 60%;
    }
  }
  .r1__sun span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, #fff3dc 0%, #ffd79a 42%, #f39a52 78%, #e2683c 100%);
    box-shadow: 0 0 70px 24px rgb(243 154 82 / 0.4);
  }

  .r1__ridges {
    inset-inline: 0;
    bottom: -1px;
    width: 100%;
    height: 42%;
  }
  .r1__fill--back {
    fill: #2c1f36;
  }
  .r1__fill--mid {
    fill: #181429;
  }
  .r1__fill--front {
    fill: var(--night);
  }
  .r1__crest {
    fill: none;
    stroke: var(--sand);
    stroke-opacity: 0.55;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  .r1__crest--front {
    stroke-opacity: 0.85;
  }

  .r1__axis {
    inset-inline-end: max(var(--gutter), 1rem);
    bottom: 6%;
    height: 34%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-inline-end: 0.6rem;
    border-inline-end: 1px solid var(--line-strong);
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--sand);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 767px) {
    .r1__axis {
      display: none;
    }
  }

  .r1__copy {
    inset-inline: 0;
    top: calc(var(--header-h) + clamp(1.5rem, 9vh, 6rem));
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }
  .r1__title {
    font-size: var(--fs-display);
    line-height: 1.02;
    max-width: 12ch;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
  }
  /* Word-by-word reveal on load (time-based, so the headline is never hidden for long) */
  .r1__word {
    display: inline-block;
    animation: r1-word 0.9s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 0.11s);
  }
  @keyframes r1-word {
    from {
      opacity: 0;
      transform: translateY(0.4em);
      filter: blur(6px);
    }
  }
  .r1__lead,
  .r1__actions,
  .r1__coords {
    animation: r1-fade 0.9s var(--ease-out) 0.75s both;
  }
  @keyframes r1-fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .r1__lead {
    font-size: var(--fs-lead);
    max-width: 30ch;
    color: rgb(244 241 232 / 0.9);
  }
  .r1__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }
  .r1__coords {
    margin-block-start: 0.25rem;
    color: rgb(244 241 232 / 0.75);
  }
  .r1__actions .btn {
    white-space: nowrap;
  }

  /* Reduced motion: a quiet, complete night scene. No sticky, no sunset. */
  @media (prefers-reduced-motion: reduce) {
    .r1 {
      height: 100svh;
    }
    .r1__gold,
    .r1__dusk,
    .r1__sun {
      display: none;
    }
    .r1__stars {
      opacity: 1;
    }
  }
</style>

<script>
  import { initR1 } from '../scripts/r1';
  document.addEventListener('astro:page-load', initR1);
</script>
