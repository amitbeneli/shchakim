---
// R1: day to night over the crater, photographic: real rock planes, a soft setting sun.
// The section is taller than the screen; its stage is position:sticky and GSAP
// scrubs one timeline against scroll (sticky, not GSAP pin: steadier on iOS).
// Layers: night sky + canvas stars (end state), dusk and gold washes (start
// state), the sun and its horizon glow, and three ridge planes cut from real photos.

import BookingBar from './BookingBar.astro';
import { photos, src } from '../data/images';

// two lines, revealed word by word
const lines = [['סוויטות', 'לתצפית', 'כוכבים'], ['על', 'שפת', 'מכתש', 'רמון']];
const words = lines.flat();

// Ridge outlines for the three rock planes, generated (seeded, so every build is the
// same) as natural profiles instead of drawn shapes: the far wall is the crater's long,
// nearly level plateau; the middle plane carries a few low flat-topped mesas; the near
// rim is rough rock that drops away on one side. Each becomes a CSS mask (data URI).
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
// smooth value noise: a few octaves of interpolated random points
function noise(seed: number, octaves: [number, number][]) {
  const layers = octaves.map(([cell, amp], i) => {
    const r = rng(seed + i * 101);
    const pts = Array.from({ length: Math.ceil(1440 / cell) + 2 }, () => r() * 2 - 1);
    return (x: number) => {
      const p = x / cell, k = Math.floor(p), t = p - k, u = t * t * (3 - 2 * t);
      return (pts[k] * (1 - u) + pts[k + 1] * u) * amp;
    };
  });
  return (x: number) => layers.reduce((a, l) => a + l(x), 0);
}
const W = 1440, H = 300, STEP = 6;
function profile(fn: (x: number) => number) {
  let d = 'M0 ' + fn(0).toFixed(1);
  for (let x = STEP; x <= W; x += STEP) d += ' L' + x + ' ' + fn(x).toFixed(1);
  return d + ' V' + H + ' H0Z';
}
const plateau = (x: number, c: number, w: number, h: number, edge: number) => {
  const dx = Math.abs(x - c) - w / 2;
  return dx <= 0 ? h : dx < edge ? h * (1 - (dx / edge) ** 1.6) : 0;
};
const backN = noise(11, [[220, 5], [60, 2.2], [14, 0.8]]);
const midN = noise(23, [[90, 4], [22, 1.6], [7, 0.6]]);
const frontN = noise(37, [[120, 7], [30, 3], [9, 1.4]]);
const outlines = {
  back: profile((x) => 66 + backN(x)),
  mid: profile((x) => 192 + midN(x) - plateau(x, 300, 120, 34, 70) - plateau(x, 930, 170, 26, 90) - plateau(x, 1260, 60, 18, 50)),
  front: profile((x) => {
    // near rim: high and rough on the right (where we stand), the cliff falls away to the left
    const rim = 214 + frontN(x);
    const fall = x < 780 ? Math.min(1, (780 - x) / 90) : 0;
    return rim + fall * (64 + frontN(x * 1.7) * 0.6);
  }),
};
const mask = (d: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(`<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 ${W} ${H}'><path d='${d}' fill='#fff'/></svg>`)}")`;
// Far wall hazy and wide, crater floor in between, the near cliff face closest
const rocks = { back: photos.craterDusk, mid: photos.craterRed, front: photos.rimCliff };
---

<section class="r1" data-hero data-r1 aria-labelledby="hero-title">
  <div class="r1__stage">
    <div class="r1__night" data-r1-night></div>
    <canvas class="r1__stars" data-r1-stars></canvas>
    <div class="r1__dusk" data-r1-dusk></div>
    <div class="r1__gold" data-r1-gold></div>
    <div class="r1__glow" data-r1-glow></div>
    <div class="r1__sun" data-r1-sun><span></span></div>

    <!-- Three ridge planes, each a real Ramon photo cut to the crater-section outline
         (CSS mask), tinted for depth, with a shade that deepens into night and the sand
         crest line on top. Each plane is its own layer, so parallax stays transform-only. -->
    {
      (['back', 'mid', 'front'] as const).map((k) => (
        <div class={`r1__ridge r1__ridge--${k}`} data-r1-ridge={k} aria-hidden="true" style={`--mask:${mask(outlines[k])}`}>
          <div class="r1__rock"><span style={`--rs:url(${src(rocks[k], k === 'back' ? 800 : 480, true)});--rl:url(${src(rocks[k], 1800, true)})`}></span></div>
          <div class="r1__shade" data-r1-shade></div>
        </div>
      ))
    }

    <div class="container r1__copy">
      <h1 id="hero-title" class="r1__title" aria-label={words.join(' ')}>
        {lines.map((line, li) => (
          <span class="r1__line" aria-hidden="true">
            {line.map((w, wi) => (
              <span class="r1__word" style={`--i:${li * 3 + wi}`}>{w}</span>
            ))}
          </span>
        ))}
      </h1>
      <p class="r1__lead">תשע סוויטות עם מרפסות פתוחות, תקרות זכוכית וטלסקופים, הרחק מאורות העיר.</p>
      <div class="r1__actions">
        <a href="/book" class="btn">להזמין לילה</a>
        <a href="/suites" class="btn btn--ghost">הסוויטות</a>
      </div>
    </div>

    <!-- Desktop: availability search docked on the near rim. Phones get it right under the hero. -->
    <div class="container r1__book">
      <BookingBar id="bb-hero" />
    </div>
  </div>
</section>

<style>
  .r1 {
    position: relative;
    height: 210svh;
  }
  @media (max-width: 767px) {
    .r1 {
      height: 175svh;
    }
  }
  .r1__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--night);
  }
  .r1__stage > * {
    position: absolute;
  }

  /* Night (end state): deep sky with a low glow along the horizon */
  .r1__night {
    inset: -5% 0 0;
    background:
      radial-gradient(120% 60% at 70% 85%, rgb(42 30 63 / 0.85), transparent 70%),
      linear-gradient(to bottom, #070914 0%, var(--night) 55%, #141127 100%);
    will-change: transform;
  }
  .r1__stars {
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  /* Dusk fades second (purple → night) */
  .r1__dusk {
    inset: 0;
    background: linear-gradient(to bottom, #0f1226 0%, #1c1834 34%, var(--dusk) 58%, #4e2c45 80%, #7a3e40 100%);
  }
  /* Gold fades first (ember → purple) */
  .r1__gold {
    inset: 0;
    background: linear-gradient(to bottom, #1b1c38 0%, #3a2a4a 26%, #6e3c50 44%, #b0604c 58%, #d98a5c 66%, #edb983 72%);
  }

  /* The sun as light, not a drawing: a small hot core with no hard edge, inside a
     wide haze that sits on the horizon and fades with the gold sky. */
  .r1__sun {
    inset-inline-start: 70%;
    top: 47%;
    --sun: clamp(56px, 6vw, 92px);
    width: var(--sun);
    aspect-ratio: 1;
    /* centre with margins, not translate: GSAP owns the transform */
    margin-inline-start: calc(var(--sun) / -2);
    margin-block-start: calc(var(--sun) / -2);
    will-change: transform, opacity;
  }
  @media (max-width: 767px) {
    .r1__sun {
      inset-inline-start: 68%;
      top: 58%;
    }
  }
  .r1__sun span {
    position: absolute;
    inset: -60%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #fffaf0 0 17%,
      rgb(255 236 200 / 0.95) 24%,
      rgb(255 196 130 / 0.55) 34%,
      rgb(240 140 80 / 0.22) 50%,
      transparent 70%
    );
  }
  .r1__glow {
    inset-inline: -20%;
    top: 40%;
    height: 34%;
    background: radial-gradient(50% 50% at 62% 60%, rgb(242 168 104 / 0.55), rgb(199 90 60 / 0.18) 55%, transparent 75%);
    will-change: opacity;
  }
  .r1__ridge {
    inset-inline: 0;
    bottom: -1px;
    height: 42%;
    will-change: transform;
  }
  .r1__ridge > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  /* The photo, cut to the ridge outline. The outline keeps its proportions (cover,
     anchored to the bottom), so on a phone it is cropped at the sides, never squeezed. */
  /* one mask per plane: the rock and its night shade share it */
  .r1__ridge {
    -webkit-mask: var(--mask) 50% 100% / cover no-repeat;
    mask: var(--mask) 50% 100% / cover no-repeat;
  }
  /* Each photo is placed so its own horizon (--h, fraction of the photo's height) lands on
     the ridge crest (--crest, fraction of the layer), at any screen width. --ar is the
     photo's aspect ratio; --minw keeps enough photo below the crest on tall phones. */
  .r1__rock > span {
    position: absolute;
    left: 50%;
    --w: max(100vw, var(--minw, 0px));
    width: var(--w);
    height: calc(var(--w) / var(--ar));
    top: calc(var(--crest) * 100% - var(--h) * var(--w) / var(--ar));
    translate: -50% 0;
    background: var(--rs) center / cover no-repeat;
  }
  @media (min-width: 900px) {
    .r1__rock > span {
      background-image: var(--rl);
    }
  }
  .r1__ridge--back .r1__rock > span {
    --ar: 1.5;
    --h: 0.54;
    --crest: 0.2;
    --minw: 125svh;
    filter: saturate(0.85) brightness(0.8);
  }
  .r1__ridge--mid .r1__rock > span {
    --ar: 0.667;
    --h: 0.42;
    --crest: 0.48;
    filter: saturate(0.8) brightness(0.62);
  }
  .r1__ridge--front .r1__rock > span {
    --ar: 0.751;
    --h: 0.68;
    --crest: 0.7;
    filter: saturate(0.6) brightness(0.45);
  }
  .r1__rock::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  /* Depth: the far wall sits in dusk haze, the near rim is nearly black */
  .r1__ridge--back .r1__rock::after {
    background: linear-gradient(to bottom, rgb(199 90 60 / 0.18) 15%, rgb(42 30 63 / 0.55) 45%, rgb(24 20 41 / 0.8));
  }
  .r1__ridge--mid .r1__rock::after {
    background: linear-gradient(to bottom, rgb(42 30 63 / 0.35) 45%, rgb(16 17 34 / 0.85) 85%);
  }
  .r1__ridge--front .r1__rock::after {
    background: linear-gradient(to bottom, rgb(11 14 26 / 0.4) 65%, rgb(11 14 26 / 0.9) 90%);
  }
  /* Night falls on the rock too (GSAP fades this in with the sky) */
  .r1__shade {
    background: var(--night);
    opacity: 0;
  }
  /* The booking bar sits on the near rim (desktop); phones get it under the hero */
  .r1__book {
    inset-inline: 0;
    bottom: clamp(1.25rem, 4vh, 2.5rem);
    z-index: 2;
    animation: r1-fade 0.9s var(--ease-out) 0.95s both;
  }
  .r1__book :global(.bbar) {
    max-width: 860px;
    box-shadow: 0 18px 50px -20px rgb(0 0 0 / 0.7);
  }
  @media (max-width: 899px) {
    .r1__book {
      display: none;
    }
  }

  .r1__copy {
    inset-inline: 0;
    top: calc(var(--header-h) + clamp(1.5rem, 9vh, 6rem));
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }
  .r1__title {
    font-size: clamp(2.6rem, 1.4rem + 4.6vw, 5rem);
    line-height: 1.06;
    letter-spacing: -0.01em;
    display: grid;
  }
  .r1__line {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
  }
  /* Word-by-word reveal on load (time-based, so the headline is never hidden for long) */
  .r1__word {
    display: inline-block;
    animation: r1-word 0.9s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 0.11s);
  }
  @keyframes r1-word {
    from {
      opacity: 0;
      transform: translateY(0.4em);
      filter: blur(6px);
    }
  }
  .r1__lead,
  .r1__actions {
    animation: r1-fade 0.9s var(--ease-out) 0.75s both;
  }
  @keyframes r1-fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  .r1__lead {
    font-size: var(--fs-lead);
    max-width: 34ch;
    color: rgb(244 241 232 / 0.86);
  }
  .r1__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.5rem;
  }
  .r1__actions .btn {
    white-space: nowrap;
  }

  /* Reduced motion: a quiet, complete night scene. No sticky, no sunset. */
  @media (prefers-reduced-motion: reduce) {
    .r1 {
      height: 100svh;
    }
    .r1__gold,
    .r1__dusk,
    .r1__sun,
    .r1__glow {
      display: none;
    }
    .r1__stars {
      opacity: 1;
    }
    .r1__shade {
      opacity: 0.55;
    }
  }
</style>

<script>
  import { initR1 } from '../scripts/r1';
  document.addEventListener('astro:page-load', initR1);
</script>
