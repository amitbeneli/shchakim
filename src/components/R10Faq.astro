---
// R10: accessible accordion built on native <details>/<summary> (keyboard and
// screen-reader support for free). JS only adds a smooth height animation via
// the Web Animations API; without JS or with reduced motion it opens instantly.
import { faq } from '../data/faq';
---

<section class="r10 container" aria-labelledby="faq-title">
  <h2 id="faq-title" data-reveal>שאלות נפוצות</h2>
  <div class="r10__list" data-r10>
    {
      faq.map((item, i) => (
        <details data-reveal style={`--d:${i}`}>
          <summary>
            <span>{item.q}</span>
            <i aria-hidden="true" />
          </summary>
          <div class="r10__body">
            <p>{item.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .r10 {
    display: grid;
    gap: 2rem;
    padding-block: clamp(4rem, 10vw, 7rem);
  }
  @media (min-width: 900px) {
    .r10 {
      grid-template-columns: 1fr 1.6fr;
      align-items: start;
    }
  }
  .r10 h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
  }
  /* A guest booklet, not a hairline accordion: questions set in the display face,
     each with a small moon that waxes from crescent to full when it opens */
  .r10__list {
    display: grid;
    gap: 0.25rem;
  }
  details {
    border-radius: var(--radius);
    transition: background-color 0.35s ease;
  }
  details[open] {
    background: var(--night-2);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.05rem 1rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.3;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary span {
    flex: 1;
    transition: color 0.25s ease;
  }
  summary i {
    position: relative;
    flex-shrink: 0;
    order: -1;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--starlight);
    box-shadow: 0 0 0 1px rgb(217 168 108 / 0.45);
    overflow: hidden;
  }
  /* the shadow of the moon: slides off to reveal a full moon */
  summary i::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--night);
    transform: translateX(-28%);
    transition: transform 0.6s var(--ease-out);
  }
  details[open] summary i {
    box-shadow: 0 0 12px 1px rgb(244 241 232 / 0.35);
  }
  details[open] summary i::after {
    transform: translateX(-110%);
  }
  details[open] summary span {
    color: var(--sand);
  }
  @media (hover: hover) and (pointer: fine) {
    summary:hover span {
      color: var(--sand);
    }
  }
  .r10__body {
    overflow: hidden;
  }
  .r10__body p {
    color: var(--muted);
    padding-block: 0 1.3rem;
    padding-inline: calc(2rem + 18px) 1rem;
    max-width: 44rem;
    font-size: var(--fs-body);
    line-height: 1.75;
  }
  @media (prefers-reduced-motion: reduce) {
    summary i::after {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector('[data-r10]');
    if (!list || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    list.querySelectorAll('details').forEach((d) => {
      const summary = d.querySelector('summary')!;
      const body = d.querySelector<HTMLElement>('.r10__body')!;
      let anim: Animation | null = null;

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        anim?.cancel();
        const opening = !d.open;
        if (opening) d.open = true; // must be open to measure the content
        const full = body.scrollHeight;
        anim = body.animate(
          { height: opening ? ['0px', `${full}px`] : [`${full}px`, '0px'], opacity: opening ? [0, 1] : [1, 0] },
          { duration: opening ? 420 : 320, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
        anim.onfinish = () => {
          if (!opening) d.open = false;
          anim = null;
        };
      });
    });
  });
</script>
