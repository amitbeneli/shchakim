---
// Optional night ambience: desert wind and crickets, synthesized with Web Audio
// (no audio files). Off by default and only ever started by a click. The audio
// graph lives in a module, so it keeps playing across ClientRouter page swaps.
---

<button type="button" class="snd" data-snd aria-pressed="false" aria-label="הפעלת צלילי לילה" title="צלילי לילה">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" />
    <path class="snd__on" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
    <path class="snd__off" d="m16 9.5 5 5m0-5-5 5" />
  </svg>
</button>

<style>
  /* Lives in the header next to the menu button, so it never sits on top of the content */
  .snd {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--starlight);
    cursor: pointer;
    transition:
      border-color 0.25s ease,
      color 0.25s ease;
  }
  .snd svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .snd__on {
    display: none;
  }
  .snd[aria-pressed='true'] {
    border-color: var(--sand);
    color: var(--sand);
  }
  .snd[aria-pressed='true'] .snd__on {
    display: inline;
  }
  .snd[aria-pressed='true'] .snd__off {
    display: none;
  }
  .snd:focus-visible {
    outline: 2px solid var(--sand);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .snd:hover {
      border-color: var(--sand);
    }
  }
</style>

<script>
  import { initAmbient } from '../scripts/ambient';
  document.addEventListener('astro:page-load', initAmbient);
</script>
