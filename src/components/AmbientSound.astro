---
// Optional night ambience: desert wind and crickets, synthesized with Web Audio
// (no audio files). Off by default and only ever started by a click. The audio
// graph lives in a module, so it keeps playing across ClientRouter page swaps.
---

<button type="button" class="snd" data-snd aria-pressed="false" aria-label="הפעלת צלילי לילה">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" />
    <path class="snd__on" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
    <path class="snd__off" d="m16 9.5 5 5m0-5-5 5" />
  </svg>
  <span class="snd__label" aria-hidden="true">צלילי לילה</span>
</button>

<style>
  .snd {
    position: fixed;
    z-index: 41;
    inset-inline-start: max(1rem, env(safe-area-inset-left));
    inset-block-end: max(1.25rem, env(safe-area-inset-bottom));
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 44px;
    padding-inline: 0.75rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgb(11 14 26 / 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--starlight);
    font: 600 var(--fs-label) / 1 var(--font-body);
    cursor: pointer;
    transition:
      border-color 0.25s ease,
      color 0.25s ease;
  }
  .snd svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .snd__on {
    display: none;
  }
  .snd[aria-pressed='true'] {
    border-color: var(--sand);
    color: var(--sand);
  }
  .snd[aria-pressed='true'] .snd__on {
    display: inline;
  }
  .snd[aria-pressed='true'] .snd__off {
    display: none;
  }
  .snd:focus-visible {
    outline: 2px solid var(--sand);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .snd:hover {
      border-color: var(--sand);
    }
  }
  /* Phones: an icon only, sitting just above the floating booking button */
  @media (max-width: 767px) {
    .snd {
      width: 44px;
      padding: 0;
      justify-content: center;
      inset-block-end: calc(max(1rem, env(safe-area-inset-bottom)) + 62px);
    }
    .snd__label {
      display: none;
    }
  }
</style>

<script>
  import { initAmbient } from '../scripts/ambient';
  document.addEventListener('astro:page-load', initAmbient);
</script>
