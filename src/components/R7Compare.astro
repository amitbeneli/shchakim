---
// R7: the same sky over two places. Ramon as it is; Tel Aviv is a real photo of its towers with
// its sky swapped for the same frame under city skyglow, so every surviving star lines up. The divider is a
// real role="slider": mouse, touch (pointer events) and keyboard (arrows follow the
// screen in RTL, Home/End, PageUp/PageDown).
import Photo from './Photo.astro';
import { photos } from '../data/images';
---

<section class="r7" aria-labelledby="r7-title">
  <div class="container r7__head" data-reveal>
    <span class="eyebrow">זיהום אור</span>
    <h2 id="r7-title">אותם שמיים, שני מקומות</h2>
    <p>אותו לילה ואותם כוכבים. מעל עיר כמו תל אביב, האור של הרחובות מסתיר את כולם חוץ מכמה עשרות. מעל המכתש רואים אלפים. גררו את הקו וראו את ההבדל.</p>
  </div>

  <div class="container">
    <div class="r7__frame" data-r7 data-cursor-label="גרירה" style="--pos: 50%">
      <div class="r7__sky r7__sky--ramon" aria-hidden="true">
        <Photo photo={photos.r7Ramon} decorative sizes="(min-width: 768px) 90vw, 100vw" width={1800} height={1005} />
      </div>
      <div class="r7__sky r7__sky--city" aria-hidden="true">
        <Photo photo={photos.r7City} decorative sizes="(min-width: 768px) 90vw, 100vw" width={1800} height={1005} />
      </div>
      <span class="r7__tag r7__tag--ramon">מכתש רמון</span>
      <span class="r7__tag r7__tag--city">תל אביב</span>
      <div
        class="r7__handle"
        data-r7-handle
        role="slider"
        tabindex="0"
        aria-label="השוואת שמי הלילה: כמה מהתמונה מציגה את מכתש רמון"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        aria-valuetext="חצי רמון, חצי תל אביב"
      >
        <span class="r7__knob" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M9 7l-5 5 5 5M15 7l5 5-5 5"></path></svg>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .r7 {
    padding-block: calc(clamp(3rem, 10vw, 9rem) * var(--air, 1));
  }
  .r7__head {
    display: grid;
    gap: 1rem;
    margin-block-end: clamp(1.5rem, 4vw, 2.5rem);
  }
  .r7__head h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
  }
  .r7__head p {
    color: var(--muted);
    max-width: 46ch;
    font-size: var(--step-1);
  }
  .r7__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background: #05070f;
    touch-action: pan-y; /* vertical page scroll still works; horizontal drags move the divider */
    user-select: none;
    -webkit-user-select: none;
    cursor: ew-resize;
  }
  @media (min-width: 768px) {
    .r7__frame {
      aspect-ratio: 16 / 8;
    }
  }
  .r7__sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .r7__sky :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* one frame: both layers share the crop, so every star lines up across the divider */
  .r7__sky :global(img) {
    object-position: 50% 50%;
  }
  /* RTL: Ramon is revealed from the right edge, --pos = its share of the width */
  .r7__sky--city {
    clip-path: inset(0 var(--pos) 0 0);
    will-change: clip-path;
  }
  .r7__tag {
    position: absolute;
    top: 1rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius);
    background: rgb(11 14 26 / 0.6);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    font-size: var(--step--1);
    font-weight: 600;
    pointer-events: none;
  }
  .r7__tag--ramon {
    right: 1rem;
  }
  .r7__tag--city {
    left: 1rem;
  }
  .r7__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    right: var(--pos);
    width: 44px;
    margin-right: -22px;
    display: grid;
    place-items: center;
    outline: none;
  }
  .r7__handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: var(--starlight);
    box-shadow: 0 0 12px rgb(0 0 0 / 0.5);
  }
  .r7__knob {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--starlight);
    color: var(--night);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.45);
    transition: transform 0.2s var(--ease-out);
  }
  .r7__knob svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .r7__handle:focus-visible .r7__knob {
    outline: 2px solid var(--sand);
    outline-offset: 4px;
  }
  .r7__frame.is-dragging .r7__knob {
    transform: scale(1.1);
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const frame = document.querySelector<HTMLElement>('[data-r7]');
    if (!frame) return;
    const handle = frame.querySelector<HTMLElement>('[data-r7-handle]')!;
    const ac = new AbortController();
    const { signal } = ac;

    // value = Ramon's share of the width, measured from the right edge
    let value = 50;
    let raf = 0;
    const set = (v: number) => {
      value = Math.max(0, Math.min(100, v));
      if (!raf)
        raf = requestAnimationFrame(() => {
          raf = 0;
          frame.style.setProperty('--pos', `${value}%`);
        });
      handle.setAttribute('aria-valuenow', String(Math.round(value)));
      handle.setAttribute(
        'aria-valuetext',
        value > 85 ? 'כמעט כולו מכתש רמון' : value < 15 ? 'כמעט כולו תל אביב' : `${Math.round(value)}% מכתש רמון`,
      );
    };
    const fromPointer = (clientX: number) => {
      const r = frame.getBoundingClientRect();
      set(((r.right - clientX) / r.width) * 100);
    };

    frame.addEventListener(
      'pointerdown',
      (e) => {
        frame.setPointerCapture(e.pointerId);
        frame.classList.add('is-dragging');
        fromPointer(e.clientX);
      },
      { signal },
    );
    frame.addEventListener('pointermove', (e) => frame.hasPointerCapture(e.pointerId) && fromPointer(e.clientX), { signal });
    const end = (e: PointerEvent) => {
      if (frame.hasPointerCapture(e.pointerId)) frame.releasePointerCapture(e.pointerId);
      frame.classList.remove('is-dragging');
    };
    frame.addEventListener('pointerup', end, { signal });
    frame.addEventListener('pointercancel', end, { signal });

    // Arrows move the line in the direction pressed on screen (left = more Ramon)
    handle.addEventListener(
      'keydown',
      (e) => {
        const step = e.shiftKey ? 10 : 5;
        const map: Record<string, number> = {
          ArrowLeft: value + step,
          ArrowRight: value - step,
          ArrowUp: value + step,
          ArrowDown: value - step,
          PageUp: value + 25,
          PageDown: value - 25,
          Home: 0,
          End: 100,
        };
        if (e.key in map) {
          e.preventDefault();
          set(map[e.key]);
        }
      },
      { signal },
    );

    document.addEventListener(
      'astro:before-swap',
      () => {
        ac.abort();
      },
      { once: true },
    );
  });
</script>
