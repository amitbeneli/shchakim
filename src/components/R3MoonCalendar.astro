---
// R3: the next 60 nights, each with its real computed moon phase (SVG drawn from
// the lunar age, not a fixed image). Nights within ~4 days of new moon are marked
// "recommended". Each night links into the booking wizard with that date.
// Rendered in the browser so "the next 60 nights" always starts from today.
---

<section class="r3" aria-labelledby="r3-title">
  <div class="r3__head" data-reveal>
    <h2 id="r3-title">לוח הירח</h2>
    <p>
      ככל שהירח דק יותר, השמיים כהים יותר ורואים יותר כוכבים. הלילות המסומנים הם הלילות סביב המולד, הטובים ביותר
      לתצפית. בוחרים לילה ועוברים ישר להזמנה.
    </p>
    <p class="r3__key"><span class="r3__dot" aria-hidden="true"></span> לילה מומלץ לתצפית</p>
  </div>

  <ol class="r3__grid" role="list" data-r3></ol>
  <noscript><p class="r3__noscript">לוח הירח מחושב בדפדפן ודורש JavaScript.</p></noscript>
</section>

<style>
  .r3 {
    display: grid;
    gap: 2rem;
  }
  .r3__head {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
  }
  .r3__head h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
  }
  .r3__head p {
    color: var(--muted);
  }
  .r3__key {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
  }
  .r3__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--sand);
  }
  .r3__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(86px, 1fr));
    gap: 0.5rem;
    min-height: 30rem; /* reserve space before JS fills it: no layout jump */
  }
  .r3__grid :global(a) {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 0.8rem 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--night-2);
    text-decoration: none;
    text-align: center;
    transition:
      border-color 0.2s ease,
      transform 0.3s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .r3__grid :global(a:hover) {
      border-color: var(--sand);
      transform: translateY(-3px);
    }
  }
  .r3__grid :global(.is-dark) {
    border-color: rgb(217 168 108 / 0.55);
    background: linear-gradient(to bottom, rgb(217 168 108 / 0.1), var(--night-2));
  }
  .r3__grid :global(.is-dark)::after {
    content: '';
    position: absolute;
    top: 8px;
    inset-inline-start: 8px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sand);
  }
  .r3__grid :global(.r3__wd) {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .r3__grid :global(.r3__d) {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .r3__grid :global(.r3__pct) {
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>

<script>
  import { addDays, todayInIsrael, weekday } from '../lib/dates';
  import { moonForNight, moonSvg } from '../lib/moon';

  const WD = ['א׳', 'ב׳', 'ג׳', 'ד׳', 'ה׳', 'ו׳', 'ש׳'];
  const WD_FULL = ['ראשון', 'שני', 'שלישי', 'רביעי', 'חמישי', 'שישי', 'שבת'];
  const fmt = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'numeric', timeZone: 'UTC' });
  const fmtLong = new Intl.DateTimeFormat('he-IL', { day: 'numeric', month: 'long', timeZone: 'UTC' });

  document.addEventListener('astro:page-load', () => {
    const list = document.querySelector<HTMLOListElement>('[data-r3]');
    if (!list) return;
    const today = todayInIsrael();
    const html: string[] = [];
    for (let i = 0; i < 60; i++) {
      const d = addDays(today, i);
      const m = moonForNight(d);
      const pct = Math.round(m.k * 100);
      const utc = Date.parse(`${d}T00:00:00Z`);
      const label = `${i === 0 ? 'הלילה, ' : ''}יום ${WD_FULL[weekday(d)]} ${fmtLong.format(utc)}: הירח מואר ${pct}%${m.dark ? ', לילה מומלץ לתצפית' : ''}. להזמנה`;
      html.push(
        `<li><a href="/book?date=${d}" class="${m.dark ? 'is-dark' : ''}" aria-label="${label}">` +
          `<span class="r3__wd">${i === 0 ? 'הלילה' : WD[weekday(d)]}</span>` +
          moonSvg(m.k, m.waxing, 34) +
          `<span class="r3__d">${fmt.format(utc)}</span>` +
          `<span class="r3__pct" dir="ltr">${pct}%</span></a></li>`,
      );
    }
    list.innerHTML = html.join('');
    list.style.minHeight = '';
  });
</script>
