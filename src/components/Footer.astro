---
import Wordmark from './Wordmark.astro';
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Wordmark size="lg" />
      <p>{site.tagline}. תשע סוויטות בשלושה סוגים, דרך בראשית, מצפה רמון.</p>
    </div>

    <nav aria-label="ניווט בפוטר">
      <h2 class="site-footer__title">באתר</h2>
      <ul role="list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/book">הזמנה</a></li>
        <li><a href="/accessibility">הצהרת נגישות</a></li>
        <li><a href="/terms">תקנון</a></li>
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__title">איך מגיעים</h2>
      <address>
        <p>{site.address}</p>
        <p><a href={site.phoneHref}><bdi dir="ltr">{site.phone}</bdi></a></p>
      </address>
    </div>
  </div>

  <div class="container site-footer__bottom">
    <p>© <bdi>{year}</bdi> שחקים. כל הזכויות שמורות.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: 1px solid var(--line);
    padding-block: clamp(3rem, 8vw, 5rem) calc(2rem + env(safe-area-inset-bottom));
    background: linear-gradient(to bottom, var(--night), var(--night-2));
    color: var(--muted);
  }
  .site-footer__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .site-footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
  .site-footer__brand {
    display: grid;
    justify-items: start;
    gap: 1rem;
    max-width: 28rem;
  }
  .site-footer__title {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--sand);
    margin-block-end: 0.75rem;
  }
  .site-footer ul {
    display: grid;
    gap: 0.25rem;
  }
  .site-footer a {
    text-decoration: none;
    display: inline-block;
    padding-block: 0.25rem;
  }
  .site-footer a:hover {
    color: var(--starlight);
  }
  address {
    font-style: normal;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-block-start: 3rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
    font-size: var(--step--1);
  }
</style>
