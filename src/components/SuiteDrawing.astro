---
// Architectural section of each suite, drawn in sand ink on the crater rim.
// The lodge is fictional, so the suites are drawn rather than borrowed from
// other hotels' photos. Lines carry pathLength=1 so they can draw themselves
// (see .draw in the parent / home script). Labels are real text.
import type { SuiteSlug } from '../data/pricing';

interface Props {
  slug: SuiteSlug;
  class?: string;
}
const { slug, class: cls } = Astro.props;

// Shared terrain: the rim plateau on the right, the cliff dropping to the crater floor on the left
const terrain = 'M400 206 H158 L148 214 L134 212 L122 228 L108 226 L92 246 L70 250 L40 262 H0';
const stars = [
  [40, 34], [92, 18], [140, 46], [210, 22], [262, 40], [318, 16], [372, 38], [24, 82], [70, 64], [356, 70],
];
---

<svg class:list={['sdraw', cls]} viewBox="0 0 400 280" aria-hidden="true">
  <g class="sdraw__stars">
    {stars.map(([x, y]) => <circle cx={x} cy={y} r="1.4" />)}
  </g>

  {
    slug === 'makhtesh' && (
      <g class="sdraw__ink">
        {/* single-storey suite, full glass wall facing the crater, deck cantilevered over the cliff */}
        <path pathLength="1" d="M206 206 V132 H346 V206" />
        <path pathLength="1" class="is-glass" d="M206 138 H170 M206 150 H170 M206 162 H170 M206 174 H170 M206 186 H170 M206 198 H170" />
        <path pathLength="1" d="M206 132 L198 126 H354 L346 132" />
        <path pathLength="1" d="M206 206 H150 V210 H206" />
        <path pathLength="1" d="M152 206 V186 M152 186 H206 M164 206 V186 M176 206 V186 M188 206 V186" />
        <path pathLength="1" d="M232 206 V194 H292 V206 M232 194 V186 H246 V194" />
        <path pathLength="1" class="is-sight" d="M200 180 L96 70" />
      </g>
    )
  }
  {
    slug === 'kochav' && (
      <g class="sdraw__ink">
        {/* bed directly under a glass ceiling */}
        <path pathLength="1" d="M196 206 V128 H352 V206" />
        <path pathLength="1" d="M196 128 L230 104 H318 L352 128" />
        <path pathLength="1" class="is-glass" d="M236 104 L240 128 M252 104 L254 128 M268 104 L268 128 M284 104 L282 128 M300 104 L296 128" />
        <path pathLength="1" d="M236 206 V188 H316 V206 M236 188 V176 H252 V188" />
        <path pathLength="1" d="M222 206 V196 H232 M330 206 V196 H340" />
        <path pathLength="1" d="M196 206 H168 V202 H196" />
        <path pathLength="1" class="is-sight" d="M276 178 V44" />
      </g>
    )
  }
  {
    slug === 'galaxia' && (
      <g class="sdraw__ink">
        {/* two-storey villa, stair to a roof deck with a hot tub and a private telescope */}
        <path pathLength="1" d="M186 206 V96 H360 V206 M186 152 H360" />
        <path pathLength="1" class="is-glass" d="M186 104 H160 M186 116 H160 M186 128 H160 M186 140 H160" />
        <path pathLength="1" d="M330 206 L330 196 L340 196 L340 186 L350 186 L350 176 L360 176" />
        <path pathLength="1" d="M186 96 V82 M360 96 V82 M186 82 H360" />
        <path pathLength="1" d="M296 96 V86 Q296 80 302 80 H342 Q348 80 348 86 V96" />
        <path pathLength="1" d="M226 96 L238 70 M238 70 L250 96 M238 70 L238 96" />
        <path pathLength="1" d="M222 64 L262 46 L266 54 L226 72 Z" />
        <path pathLength="1" d="M214 194 V178 H262 V194 M214 140 V126 H262 V140" />
        <path pathLength="1" class="is-sight" d="M264 50 L330 14" />
      </g>
    )
  }

  <path pathLength="1" class="sdraw__ground" d={terrain} />
  <path class="sdraw__hatch" d="M158 214 l-10 10 M176 214 l-10 10 M194 214 l-10 10 M212 214 l-10 10 M230 214 l-10 10 M248 214 l-10 10 M266 214 l-10 10 M284 214 l-10 10 M302 214 l-10 10 M320 214 l-10 10 M338 214 l-10 10 M356 214 l-10 10 M374 214 l-10 10 M392 214 l-10 10" />

  <g class="sdraw__labels">
    {
      slug === 'makhtesh' && (
        <>
          <text x="152" y="176" text-anchor="end">מרפסת מעל המצוק</text>
          <text x="276" y="120" text-anchor="middle">קיר זכוכית אל המכתש</text>
        </>
      )
    }
    {
      slug === 'kochav' && (
        <>
          <text x="284" y="96" text-anchor="start">תקרת זכוכית</text>
          <text x="276" y="226" text-anchor="middle">המיטה, מתחת לשמיים</text>
        </>
      )
    }
    {
      slug === 'galaxia' && (
        <>
          <text x="214" y="40" text-anchor="end">טלסקופ פרטי</text>
          <text x="322" y="72" text-anchor="middle">ג׳קוזי על הגג</text>
        </>
      )
    }
    <text class="sdraw__h" x="396" y="200" text-anchor="end">▲ 868</text>
  </g>
</svg>

<style>
  .sdraw {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .sdraw__stars circle {
    fill: var(--starlight);
    opacity: 0.55;
  }
  .sdraw__ink path,
  .sdraw__ground {
    fill: none;
    stroke: var(--sand);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .sdraw__ink .is-glass {
    stroke: var(--starlight);
    stroke-opacity: 0.55;
    stroke-width: 1;
  }
  .sdraw__ink .is-sight {
    stroke: var(--ember);
    stroke-dasharray: 0.02 0.02;
    stroke-width: 1.2;
  }
  .sdraw__hatch {
    stroke: var(--sand);
    stroke-opacity: 0.35;
    stroke-width: 1;
  }
  .sdraw__labels text {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 11px;
    fill: var(--starlight);
    fill-opacity: 0.85;
  }
  .sdraw__labels .sdraw__h {
    fill: var(--sand);
    font-variant-numeric: tabular-nums;
  }
</style>
