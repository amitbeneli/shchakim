---
// Quick availability search, the way hotel sites lead (date · nights · guests).
// A plain GET form to /book, so it works before (and without) JavaScript; the wizard
// reads ?date=&nights=&guests= as a one-time pre-fill. The script only sets today's
// date as the minimum (the page is static, so it can't be baked in at build time).

interface Props {
  /** unique prefix: the bar renders twice on the home page (in the hero / under it) */
  id: string;
  class?: string;
}
const { id, class: cls } = Astro.props;
---

<form class:list={['bbar', cls]} action="/book" method="get" data-bbar aria-label="בדיקת זמינות">
  <div class="bbar__field bbar__field--date">
    <label for={`${id}-date`}>תאריך הגעה</label>
    <!-- The native picker stays (it is the best one on phones), but the browser formats the date in
         its own locale (10/26/2026 in an English Chrome). A Hebrew-formatted copy sits on top of it;
         the native text shows again only while the field is being typed into. -->
    <div class="bbar__date">
      <input id={`${id}-date`} name="date" type="date" required data-bbar-date />
      <span class="bbar__date-text" aria-hidden="true" data-bbar-date-text></span>
    </div>
  </div>
  <div class="bbar__field">
    <label for={`${id}-nights`}>לילות</label>
    <select id={`${id}-nights`} name="nights">
      {[1, 2, 3, 4, 5, 6, 7].map((n) => <option value={n} selected={n === 2}>{n === 1 ? 'לילה אחד' : `${n} לילות`}</option>)}
    </select>
  </div>
  <div class="bbar__field">
    <label for={`${id}-guests`}>אורחים</label>
    <select id={`${id}-guests`} name="guests">
      {[1, 2, 3, 4].map((n) => <option value={n} selected={n === 2}>{n === 1 ? 'אורח אחד' : `${n} אורחים`}</option>)}
    </select>
  </div>
  <button type="submit" class="btn bbar__go">לבדוק זמינות</button>
</form>

<style>
  .bbar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--line);
    overflow: hidden;
  }
  .bbar__field {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.9rem 0.55rem;
    background: rgb(11 14 26 / 0.92);
    transition: background-color 0.2s ease;
  }
  .bbar__field--date {
    grid-column: 1 / -1;
  }
  .bbar__field:focus-within {
    background: var(--night-3);
  }
  .bbar label {
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--sand);
  }
  .bbar input,
  .bbar select {
    width: 100%;
    min-height: 2rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--starlight);
    font: inherit;
    font-size: var(--fs-body);
    color-scheme: dark;
    cursor: pointer;
  }
  .bbar__date {
    position: relative;
  }
  .bbar__date-text {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    display: flex;
    align-items: center;
    font-size: var(--fs-body);
    color: var(--starlight);
    pointer-events: none;
  }
  /* hide the browser's own (locale-formatted) text */
  .bbar__date input:not(:focus)::-webkit-datetime-edit {
    color: transparent;
  }
  /* the calendar trigger is stretched over the whole field, invisible: tapping anywhere opens
     the picker, and no icon sits on top of the Hebrew date */
  .bbar__date input::-webkit-calendar-picker-indicator {
    position: absolute;
    inset: 0;
    width: auto;
    height: auto;
    opacity: 0;
    cursor: pointer;
  }
  .bbar__date:focus-within .bbar__date-text {
    visibility: hidden;
  }
  .bbar select option {
    background: var(--night-2);
  }
  .bbar input:focus,
  .bbar select:focus {
    outline: none;
  }
  .bbar__go {
    grid-column: 1 / -1;
    justify-content: center;
    border-radius: 0;
    min-height: 3.25rem;
  }
  @media (min-width: 720px) {
    .bbar {
      grid-template-columns: 1.3fr 1fr 1fr auto;
    }
    .bbar__field--date,
    .bbar__go {
      grid-column: auto;
    }
    .bbar__go {
      padding-inline: 1.75rem;
    }
  }
</style>

<script>
  import { todayInIsrael } from '../lib/dates';

  document.addEventListener('astro:page-load', () => {
    const today = todayInIsrael();
    document.querySelectorAll<HTMLInputElement>('[data-bbar-date]').forEach((el) => {
      el.min = today;
      if (!el.value) el.value = today;
      const text = el.parentElement!.querySelector<HTMLElement>('[data-bbar-date-text]')!;
      // Israeli format, d.m.yyyy, whatever the browser's language
      const show = () => {
        const [y, m, d] = el.value.split('-');
        text.textContent = el.value ? `${Number(d)}.${Number(m)}.${y}` : '';
      };
      show();
      el.addEventListener('input', show);
      el.addEventListener('change', show);
    });
  });
</script>
