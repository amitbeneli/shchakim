---
// The crater as a trail map: build-time contours (src/lib/topo.ts), the lodge
// as a surveyed point on the north-west rim, the town, a marked trail down to
// the floor, a scale bar and a north arrow. Decorative geometry is aria-hidden;
// the figure carries a text description for screen readers.
import { ramonTopo } from '../lib/topo';

const t = ramonTopo();
const [lx, ly] = t.lodge;
const [tx, ty] = t.town;
const [ax, ay] = t.axis.a;
const [bx, by] = t.axis.b;
const angle = (Math.atan2(by - ay, bx - ax) * 180) / Math.PI;
const mid = [(ax + bx) / 2 - 40, (ay + by) / 2 + 40];
// A marked trail: from the lodge, down the scarp, onto the crater floor
const trail = `M${lx} ${ly} C ${lx + 10} ${ly + 40}, ${lx - 30} ${ly + 70}, ${lx - 20} ${ly + 110} S ${lx - 70} ${ly + 170}, ${lx - 110} ${ly + 190}`;
---

<figure class="topo" aria-label="מפת מכתש רמון: שחקים יושב על השפה הצפונית-מערבית של המכתש, מתחת לעיר מצפה רמון.">
  <svg viewBox={`0 0 ${t.width} ${t.height}`} aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <g class="topo__lines">
      {t.levels.map((l) => <path d={l.d} class={l.index ? 'is-index' : undefined} />)}
    </g>

    <path class="topo__trail" d={trail} />

    <!-- Crater name along its axis -->
    <text class="topo__name" transform={`translate(${mid[0]} ${mid[1]}) rotate(${angle})`} text-anchor="middle">מכתש רמון</text>

    <!-- Town -->
    <g transform={`translate(${tx} ${ty})`}>
      <rect class="topo__town" x="-5" y="-5" width="10" height="10" />
      <text class="topo__label" x="-14" y="5" text-anchor="end">מצפה רמון</text>
    </g>

    <!-- The lodge: survey triangle + blaze -->
    <g class="topo__lodge" transform={`translate(${lx} ${ly})`}>
      <circle class="topo__pulse" r="18" />
      <path class="topo__tri" d="M0 -9 L8 6 L-8 6 Z" />
      <g transform="translate(16 -26)">
        <rect class="topo__flag" x="-4" y="-16" width="96" height="28" />
        <rect x="80" y="-11" width="5" height="3.5" fill="#f4f1e8" />
        <rect x="80" y="-7.5" width="5" height="4" fill="#e2683c" />
        <rect x="80" y="-3.5" width="5" height="3.5" fill="#f4f1e8" />
        <text class="topo__lodge-name" x="72" y="3" text-anchor="end">שחקים</text>
      </g>
    </g>

    <!-- Scale bar: the real crater is ~40 km long ≈ 790 map units, so 50 units ≈ 2.5 km -->
    <g class="topo__scale" transform={`translate(${t.width - 190} ${t.height - 34})`}>
      <rect x="0" y="0" width="50" height="5" class="is-dark" />
      <rect x="50" y="0" width="50" height="5" class="is-light" />
      <rect x="100" y="0" width="50" height="5" class="is-dark" />
      <text x="0" y="22" text-anchor="middle">0</text>
      <text x="150" y="22" text-anchor="middle">7.5 ק״מ</text>
    </g>
    <g class="topo__north" transform="translate(48 56)">
      <path d="M0 -24 L9 10 L0 4 L-9 10 Z" />
      <text y="30" text-anchor="middle">צ</text>
    </g>
  </svg>
</figure>

<style>
  .topo {
    position: relative;
    margin: 0;
    aspect-ratio: 1000 / 600;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(16 20 42 / 0.6);
    overflow: hidden;
  }
  .topo svg {
    width: 100%;
    height: 100%;
  }
  .topo__lines path {
    fill: none;
    stroke: var(--sand);
    stroke-opacity: 0.28;
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }
  .topo__lines path.is-index {
    stroke-opacity: 0.62;
    stroke-width: 1.3;
  }
  .topo__trail {
    fill: none;
    stroke: var(--ember);
    stroke-width: 2.4;
    stroke-dasharray: 7 6;
    vector-effect: non-scaling-stroke;
  }
  .topo__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 34px;
    fill: var(--starlight);
    fill-opacity: 0.88;
    letter-spacing: 0.04em;
  }
  .topo__label,
  .topo__scale text,
  .topo__north text {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15px;
    fill: var(--starlight);
  }
  .topo__town {
    fill: var(--starlight);
  }
  .topo__tri {
    fill: var(--ember);
    stroke: var(--night);
    stroke-width: 1.5;
  }
  .topo__flag {
    fill: var(--night);
    stroke: var(--sand);
    stroke-width: 1;
  }
  .topo__lodge-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    fill: var(--starlight);
  }
  .topo__pulse {
    fill: none;
    stroke: var(--ember);
    stroke-width: 1.5;
    transform-origin: center;
    transform-box: fill-box;
    animation: topo-pulse 2.8s var(--ease-out) infinite;
  }
  @keyframes topo-pulse {
    from {
      transform: scale(0.4);
      opacity: 0.9;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }
  .topo__scale .is-dark {
    fill: var(--sand);
  }
  .topo__scale .is-light {
    fill: var(--night);
    stroke: var(--sand);
    stroke-width: 1;
  }
  .topo__north path {
    fill: var(--sand);
  }
  @media (prefers-reduced-motion: reduce) {
    .topo__pulse {
      animation: none;
      opacity: 0.6;
    }
  }
</style>
