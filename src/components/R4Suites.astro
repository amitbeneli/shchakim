---
// R4: suites gallery.
// - Default (touch / narrow / reduced motion): a native scroll-snap carousel.
//   RTL means the first card sits at the right and the finger swipes leftward.
// - Desktop with a fine pointer: JS adds .is-pinned, the section pins to the
//   screen and vertical scroll slides the cards horizontally, right → left.
import Photo from './Photo.astro';
import { suites } from '../data/pricing';
import { formatPrice } from '../lib/format';
---

<section class="r4" data-r4 aria-labelledby="suites-title">
  <!-- Carousel mode: the heading sits above the cards. Pinned (desktop) mode shows the
       same words as the first panel of the moving track, and this block becomes
       visually hidden so the h2 stays in the document outline. -->
  <div class="container r4__head">
    <h2 id="suites-title">הסוויטות</h2>
    <p>תשע סוויטות בשלושה סוגים, כולן על שפת המצוק ופונות אל המכתש.</p>
    <a href="/suites" class="text-link">כל הסוויטות</a>
  </div>
  <div class="r4__pin">
    <ul role="list" class="r4__track" data-r4-track>
      <li class="r4__intro" aria-hidden="true">
        <p class="r4__intro-title">הסוויטות</p>
        <p>תשע סוויטות בשלושה סוגים, כולן על שפת המצוק ופונות אל המכתש.</p>
        <a href="/suites" class="text-link" tabindex="-1">כל הסוויטות</a>
      </li>
      {
        suites.map((s, i) => (
          <li class="r4__card" style={`--d:${i}`}>
            <article class="r4__inner">
              <div class="r4__media" transition:name={`suite-media-${s.slug}`}>
                <Photo photo={s.photo} sizes="(min-width: 768px) 52vw, 80vw" width={1500} height={1000} />
                <p class="r4__tag">{s.highlight}</p>
              </div>
              <div class="r4__text">
                <h3>
                  <a href={`/suites/${s.slug}`} class="r4__link">{s.name}</a>
                </h3>
                <p class="r4__meta">
                  עד {s.maxGuests} אורחים<span aria-hidden="true"> · </span>{s.units} יחידות במתחם
                </p>
                <div class="r4__foot">
                  <p class="r4__price">
                    <span>החל מ־</span>
                    <bdi>{formatPrice(s.nightly)}</bdi>
                    <span>ללילה, כולל מע״מ</span>
                  </p>
                  <a href={`/book?suite=${s.slug}`} class="btn r4__book">
                    להזמין<span class="visually-hidden"> את {s.name}</span>
                  </a>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .r4 {
    padding-block: clamp(2.5rem, 7vw, 7rem) clamp(4rem, 10vw, 7rem);
  }

  /* ── Carousel (default) ── */
  .r4__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 80%;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: var(--gutter);
    padding-block-end: 0.5rem;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .r4__track::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 768px) {
    .r4__track {
      grid-auto-columns: 42%;
      gap: 1.5rem;
    }
  }
  .r4__track > li {
    scroll-snap-align: start;
  }
  .r4__intro {
    display: grid;
    align-content: end;
    gap: 1rem;
    padding-block-end: 1rem;
  }
  /* carousel mode: heading above, intro panel hidden */
  .r4__head {
    display: grid;
    gap: 0.75rem;
    margin-block-end: clamp(1.5rem, 4vw, 2.25rem);
  }
  .r4__head h2 {
    font-size: var(--fs-h2);
  }
  .r4__head p {
    color: var(--muted);
    max-width: 40ch;
  }
  .r4__head .text-link {
    justify-self: start;
  }
  .r4:not(.is-pinned) .r4__intro {
    display: none;
  }
  .r4.is-pinned .r4__head {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    margin: 0;
    padding: 0;
  }
  .r4__intro-title,
  .r4__intro h2 {
    font-family: var(--font-display);
    color: var(--starlight) !important;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 500;
    line-height: 1.12;
  }
  .r4__intro p {
    color: var(--muted);
    max-width: 30ch;
  }
  .r4__inner {
    position: relative;
    display: grid;
    gap: 1rem;
  }
  /* The photo of the suite itself, under the site-wide grade */
  .r4__media {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--night-2);
  }
  .r4__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .r4__tag {
    position: absolute;
    inset-block-end: 0.75rem;
    inset-inline-start: 0.75rem;
    padding: 0.3rem 0.65rem;
    border-radius: var(--radius);
    background: rgb(11 14 26 / 0.78);
    color: var(--starlight);
    font-size: var(--fs-label);
    font-weight: 600;
  }
  .r4__text {
    display: grid;
    gap: 0.4rem;
  }
  .r4__card h3 {
    font-size: var(--fs-h3);
  }
  .r4__link {
    text-decoration: none;
  }
  /* The whole card opens the suite page; the book button sits above this layer */
  .r4__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .r4__meta {
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .r4__foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 0.6rem;
    padding-block-start: 0.9rem;
    border-block-start: 1px solid var(--line);
  }
  .r4__price {
    display: grid;
    line-height: 1.25;
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .r4__price bdi {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--starlight);
  }
  .r4__book {
    position: relative;
    z-index: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .r4__inner:hover .r4__media :global(img) {
      transform: scale(1.035);
    }
    .r4__inner:hover h3 {
      color: var(--sand);
    }
  }
  .r4__link:focus-visible {
    outline: none;
  }
  .r4__inner:has(.r4__link:focus-visible) .r4__media {
    outline: 2px solid var(--sand);
    outline-offset: 3px;
  }

  /* ── Pinned horizontal mode (desktop, set by JS) ── */
  .r4.is-pinned {
    padding-block: 0;
  }
  .r4.is-pinned .r4__pin {
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .r4.is-pinned .r4__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: clamp(2rem, 4vw, 4.5rem);
    overflow: visible;
    padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    will-change: transform;
  }
  .r4.is-pinned .r4__intro {
    width: clamp(300px, 28vw, 440px);
    align-content: center;
  }
  .r4.is-pinned .r4__card {
    width: min(52vw, 78svh);
  }
  .r4.is-pinned .r4__media {
    aspect-ratio: 16 / 10;
    max-height: 56svh;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('astro:page-load', () => {
    const section = document.querySelector<HTMLElement>('[data-r4]');
    if (!section) return;
    const track = section.querySelector<HTMLElement>('[data-r4-track]')!;

    const mm = gsap.matchMedia();
    // Pinning only where it feels good: a real mouse/trackpad, wide screen, motion allowed
    mm.add('(min-width: 768px) and (pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
      section.classList.add('is-pinned');
      // RTL: the track overflows to the LEFT, so we move it RIGHT (positive x)
      const distance = () => Math.max(0, track.scrollWidth - innerWidth);
      gsap.to(track, {
        x: distance,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
        },
      });
      return () => section.classList.remove('is-pinned');
    });

    document.addEventListener('astro:before-swap', () => mm.revert(), { once: true });
  });
</script>
