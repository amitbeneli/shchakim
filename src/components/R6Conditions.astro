---
// R6: tonight's observing conditions, live from Open-Meteo (no key needed).
// Average cloud cover 21:00–03:00 + real moon illumination → a rating with its
// rule spelled out. Timeout 6s, cached 30 min in sessionStorage, and a calm
// message instead of a broken widget if the API is down.
import { RULE_TEXT } from '../lib/conditions';
---

<section class="r6 container" aria-labelledby="r6-title">
  <div class="r6__intro" data-reveal>
    <span class="eyebrow">תחזית</span>
    <h2 id="r6-title">תנאי התצפית הלילה</h2>
    <p>תחזית העננות במצפה רמון בין 21:00 ל־03:00 ותאורת הירח הלילה, בזמן אמת.</p>
  </div>

  <div class="r6__card lit-frame" data-r6 aria-live="polite" aria-busy="true">
    <!-- Tonight's real moon phase, drawn large: the visual anchor of the section -->
    <div class="r6__moon" data-r6-moon-big aria-hidden="true"></div>
    <!-- Loading skeleton: same shape as the result, so nothing jumps -->
    <div class="r6__state r6__state--loading" data-r6-loading>
      <span class="r6__sk r6__sk--title"></span>
      <span class="r6__sk"></span>
      <span class="r6__sk r6__sk--short"></span>
      <span class="visually-hidden">טוענים את תחזית הלילה</span>
    </div>

    <div class="r6__state" data-r6-result hidden>
      <p class="r6__rating"><span class="visually-hidden">תנאי התצפית הלילה: </span><span data-r6-rating></span></p>
      <p class="r6__text" data-r6-text></p>
      <p class="r6__stats">
        עננות ממוצעת <bdi class="r6__num" dir="ltr" data-r6-cloud></bdi>
        <span class="r6__dot" aria-hidden="true"></span>
        הירח מואר <bdi class="r6__num" dir="ltr" data-r6-moon></bdi>
      </p>
      <!-- weak nights: the dark nights in the moon calendar come first, booking tonight stays possible -->
      <div class="r6__actions">
        <a class="btn r6__alt" data-r6-alt href="/experiences#r3-title" hidden>למצוא לילה חשוך בלוח הירח</a>
        <a class="btn r6__cta" data-r6-cta href="/book">להזמין את הלילה הזה</a>
      </div>
    </div>

    <div class="r6__state" data-r6-error hidden>
      <p class="r6__err-title">התחזית לא זמינה כרגע</p>
      <p class="r6__text">
        לא הצלחנו לקבל את תחזית העננים. הירח הלילה מואר ב־<bdi dir="ltr" data-r6-moon-only></bdi>, ובממוצע יש כאן
        יותר מ־300 לילות צלולים בשנה.
      </p>
      <button type="button" class="r6__retry" data-r6-retry>לנסות שוב</button>
    </div>

    <p class="r6__rule">{RULE_TEXT} מקור: Open-Meteo.</p>
  </div>
</section>

<style>
  .r6 {
    display: grid;
    gap: 2rem;
    padding-block: calc(clamp(3rem, 10vw, 9rem) * var(--air, 1));
    align-items: center;
  }
  @media (min-width: 900px) {
    .r6 {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
  .r6__intro {
    display: grid;
    gap: 1rem;
  }
  .r6__intro h2 {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.4rem);
    font-weight: 400;
  }
  .r6__intro p {
    color: var(--muted);
    max-width: 34ch;
    font-size: var(--step-1);
  }
  /* A lit frame around the moon, the verdict, one sentence of numbers and one action */
  .r6__card {
    position: relative;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    min-height: 15rem;
  }
  .r6__moon {
    position: relative;
    width: clamp(120px, 22vw, 220px);
    aspect-ratio: 1;
  }
  .r6__moon::before {
    content: '';
    position: absolute;
    inset: -30%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(244 241 232 / 0.14), transparent 62%);
  }
  .r6__moon :global(svg) {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .r6__card > .r6__state,
  .r6__card > .r6__rule {
    grid-column: 2;
  }
  .r6__rule {
    grid-row: 2;
  }
  @media (max-width: 599px) {
    .r6__card {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .r6__card > .r6__state,
    .r6__card > .r6__rule {
      grid-column: 1;
    }
    .r6__rule {
      grid-row: auto;
    }
    .r6__moon {
      width: 120px;
    }
  }
  .r6__state {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }
  .r6__rating {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 2rem + 5vw, 5.5rem);
    font-weight: 500;
    line-height: 0.95;
  }
  .r6__rating[data-rating='excellent'] {
    color: var(--sand);
  }
  .r6__text {
    color: var(--muted);
    max-width: 40ch;
    font-size: var(--fs-lead);
  }
  .r6__stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    color: var(--muted);
  }
  .r6__num {
    font-family: var(--font-display);
    font-size: 1.6rem;
    color: var(--starlight);
  }
  .r6__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--sand);
    align-self: center;
    margin-inline: 0.4rem;
  }
  .r6__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 0.4rem;
  }
  .r6__err-title {
    font-family: var(--font-display);
    font-size: var(--step-2);
  }
  .r6__retry {
    justify-self: start;
    padding: 0.6rem 1.2rem;
    border-radius: var(--radius);
    border: 1px solid var(--line-strong);
    background: none;
    font-weight: 600;
    cursor: pointer;
  }
  .r6__rule {
    font-size: var(--fs-label);
    color: var(--muted);
    line-height: 1.6;
    max-width: 52ch;
  }
  .r6__sk {
    display: block;
    height: 1rem;
    border-radius: var(--radius);
    background: linear-gradient(90deg, var(--night-3), rgb(244 241 232 / 0.08), var(--night-3));
    background-size: 200% 100%;
    animation: r6-shimmer 1.4s ease-in-out infinite;
  }
  .r6__sk--title {
    height: 3.5rem;
    width: 45%;
  }
  .r6__sk--short {
    width: 60%;
  }
  @keyframes r6-shimmer {
    to {
      background-position: -200% 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .r6__sk {
      animation: none;
    }
  }
</style>

<script>
  import { averageCloud, FORECAST_URL, rate, RATING_LABEL, RATING_TEXT, type OpenMeteoHourly } from '../lib/conditions';
  import { moonForNight, moonSvg } from '../lib/moon';
  import { todayInIsrael } from '../lib/dates';

  const CACHE = 'shchakim-r6';
  const TTL = 30 * 60 * 1000;

  // One request, 6s timeout (CLAUDE.md appendix C)
  async function fetchOnce(): Promise<OpenMeteoHourly> {
    const ac = new AbortController();
    const t = setTimeout(() => ac.abort(), 6000);
    try {
      const res = await fetch(FORECAST_URL, { signal: ac.signal });
      if (!res.ok) throw new Error(String(res.status));
      return (await res.json()) as OpenMeteoHourly;
    } finally {
      clearTimeout(t);
    }
  }

  async function forecast(): Promise<OpenMeteoHourly> {
    try {
      const c = JSON.parse(sessionStorage.getItem(CACHE) ?? 'null');
      if (c && Date.now() - c.at < TTL) return c.data;
    } catch {
      /* no cache */
    }
    // A single slow/hung request shouldn't cost the visitor the forecast: retry once quietly
    const data = await fetchOnce().catch(() => fetchOnce());
    try {
      sessionStorage.setItem(CACHE, JSON.stringify({ at: Date.now(), data }));
    } catch {
      /* ignore */
    }
    return data;
  }

  async function run(card: HTMLElement) {
    const $ = <T extends HTMLElement = HTMLElement>(s: string) => card.querySelector<T>(s)!;
    const show = (which: 'loading' | 'result' | 'error') => {
      $('[data-r6-loading]').hidden = which !== 'loading';
      $('[data-r6-result]').hidden = which !== 'result';
      $('[data-r6-error]').hidden = which !== 'error';
      card.setAttribute('aria-busy', String(which === 'loading'));
    };

    // "Tonight" switches at midnight Israel time (clarified with the client)
    const today = todayInIsrael();
    const moon = moonForNight(today);
    const moonPct = Math.round(moon.k * 100);
    $('[data-r6-moon-big]').innerHTML = moonSvg(moon.k, moon.waxing, 240);
    show('loading');

    try {
      const data = await forecast();
      const cloud = averageCloud(data, today);
      if (cloud === null) throw new Error('no-data');
      const r = rate(cloud, moonPct);
      const rating = $('[data-r6-rating]');
      rating.textContent = RATING_LABEL[r];
      rating.parentElement!.dataset.rating = r;
      $('[data-r6-text]').textContent = RATING_TEXT[r];
      $('[data-r6-cloud]').textContent = `${Math.round(cloud)}%`;
      $('[data-r6-moon]').textContent = `${moonPct}%`;

      const cta = $<HTMLAnchorElement>('[data-r6-cta]');
      cta.href = `/book?date=${today}`;
      // a weak night: the moon calendar becomes the main way forward, booking tonight stays possible
      const weak = r === 'weak';
      cta.textContent = weak ? 'להזמין בכל זאת' : 'להזמין את הלילה הזה';
      cta.classList.toggle('btn--ghost', weak);
      $('[data-r6-alt]').hidden = !weak;
      show('result');
    } catch {
      $('[data-r6-moon-only]').textContent = `${moonPct}%`;
      show('error');
    }
  }

  document.addEventListener('astro:page-load', () => {
    const card = document.querySelector<HTMLElement>('[data-r6]');
    if (!card) return;
    run(card);
    card.querySelector('[data-r6-retry]')?.addEventListener('click', () => run(card));
  });
</script>
