---
import type { Suite } from '../data/pricing';
import { formatPrice } from '../lib/format';
import Photo from './Photo.astro';

interface Props {
  suite: Suite;
}
const { suite } = Astro.props;
---

<article class="suite-card">
  <div class="suite-card__media" transition:name={`suite-media-${suite.slug}`}>
    <Photo photo={suite.photo} sizes="(min-width: 900px) 33vw, 92vw" width={1500} height={1000} />
  </div>
  <div class="suite-card__body">
    <h3><a href={`/suites/${suite.slug}`} class="suite-card__link">{suite.name}</a></h3>
    <p class="suite-card__hl">{suite.highlight}</p>
    <p class="suite-card__summary">{suite.summary}</p>
    <p class="suite-card__meta">
      עד {suite.maxGuests} אורחים<span aria-hidden="true"> · </span>{suite.units} יחידות במתחם
    </p>
    <div class="suite-card__foot">
      <p class="suite-card__price">
        <span>החל מ־</span>
        <bdi>{formatPrice(suite.nightly)}</bdi>
        <span>ללילה, כולל מע״מ</span>
      </p>
      <a href={`/book?suite=${suite.slug}`} class="btn suite-card__book">
        להזמין<span class="visually-hidden"> את {suite.name}</span>
      </a>
    </div>
  </div>
</article>

<style>
  .suite-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1rem;
    height: 100%;
  }
  .suite-card__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--night-2);
  }
  .suite-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }
  .suite-card__body {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 0.45rem;
  }
  .suite-card h3 {
    font-size: var(--fs-h3);
  }
  .suite-card__link {
    text-decoration: none;
  }
  /* Whole card opens the suite; the book button sits above this layer */
  .suite-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .suite-card__link:focus-visible {
    outline: none;
  }
  .suite-card:has(.suite-card__link:focus-visible) .suite-card__media {
    outline: 2px solid var(--sand);
    outline-offset: 3px;
  }
  .suite-card__hl {
    color: var(--sand);
  }
  .suite-card__summary {
    color: var(--muted);
  }
  .suite-card__meta {
    color: var(--muted);
    font-size: var(--fs-small);
  }
  .suite-card__foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 0.5rem;
    padding-block-start: 0.9rem;
    border-block-start: 1px solid var(--line);
  }
  .suite-card__price {
    display: grid;
    line-height: 1.25;
    font-size: var(--fs-label);
    color: var(--muted);
  }
  .suite-card__price bdi {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--starlight);
  }
  .suite-card__book {
    position: relative;
    z-index: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .suite-card:hover .suite-card__media :global(img) {
      transform: scale(1.035);
    }
    .suite-card:hover h3 {
      color: var(--sand);
    }
  }
</style>
