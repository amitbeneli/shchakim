---
import type { Suite } from '../data/pricing';
import { formatPrice } from '../lib/format';
import SuiteDrawing from './SuiteDrawing.astro';

interface Props {
  suite: Suite;
}
const { suite } = Astro.props;
---

<article class="suite-card">
  <a href={`/suites/${suite.slug}`} class="suite-card__link">
    <div class="suite-card__sheet" transition:name={`suite-media-${suite.slug}`}>
      <SuiteDrawing slug={suite.slug} />
    </div>
    <div class="suite-card__body">
      <h3>{suite.name}</h3>
      <p class="suite-card__hl">{suite.highlight}</p>
      <p class="suite-card__summary">{suite.summary}</p>
      <p class="label suite-card__meta">
        עד {suite.maxGuests} אורחים<span aria-hidden="true"> · </span>
        <bdi class="price">{formatPrice(suite.nightly)}</bdi> ללילה
      </p>
    </div>
  </a>
</article>

<style>
  .suite-card {
    height: 100%;
  }
  .suite-card__link {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1rem;
    height: 100%;
    text-decoration: none;
  }
  .suite-card__sheet {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3.4;
    padding: 1.25rem 1.25rem 2rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background:
      linear-gradient(rgb(16 20 42 / 0.82), rgb(16 20 42 / 0.82)),
      url(/topo.svg) center / 220% auto,
      var(--night-2);
    transition: border-color 0.3s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .suite-card__link:hover .suite-card__sheet {
      border-color: var(--sand);
    }
  }
  .suite-card__body {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }
  .suite-card h3 {
    font-size: var(--fs-h3);
  }
  .suite-card__hl {
    color: var(--sand);
  }
  .suite-card__summary {
    color: var(--muted);
  }
  .suite-card__meta {
    color: var(--starlight);
    margin-block-start: 0.25rem;
  }
</style>
